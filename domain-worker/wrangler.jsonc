  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "kisahlillah.web.id", "custom_domain": true },
    { "pattern": "www.kisahlillah.web.id", "custom_domain": true }
  ]
