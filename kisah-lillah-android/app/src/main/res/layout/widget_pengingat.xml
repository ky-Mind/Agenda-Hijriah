<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Pengingat ukuran besar: latar warna sesuai waktu shalat yang dituju, jam besar,
     sisa waktu & pesan, logo Kisah Lillah menyembul dari kanan bawah -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/pakar" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_duo_umum" android:clipToOutline="true">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/widget_pola" android:alpha="0.14" android:contentDescription="@null" />
    <ImageView android:layout_width="120dp" android:layout_height="120dp" android:layout_gravity="bottom|end" android:layout_marginEnd="-10dp" android:layout_marginBottom="-26dp" android:src="@drawable/widget_maskot" android:scaleType="fitCenter" android:contentDescription="Kisah Lillah" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="104dp" android:paddingTop="12dp" android:paddingBottom="12dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="28dp" android:layout_height="20dp" android:src="@drawable/widget_masjid" android:contentDescription="@null" />
            <TextView android:id="@+id/pwaktu" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="--:--" android:textColor="#FFFFFFFF" android:textSize="36sp" android:textStyle="bold" android:includeFontPadding="false" android:shadowColor="#33000000" android:shadowDy="2" android:shadowRadius="4" />
        </LinearLayout>
        <TextView android:id="@+id/psisa" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Jadwal shalat" android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/ppesan" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Buka aplikasi sekali agar jadwal shalatmu tersimpan." android:textColor="#E6FFFFFF" android:textSize="12sp" android:maxLines="3" android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
