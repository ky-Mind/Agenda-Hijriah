<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Jadwal Shalat bergaya kartu hero Kisah Lillah: hijau aksen dengan pola bintang delapan, jam besar,
     hitung mundur ke shalat berikutnya, garis hias masjid, tanggal Masehi & Hijriah, kalimat pengingat,
     dan lima waktu shalat (yang sedang berjalan disorot krem keemasan seperti pita logo). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/wakar" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_kartu" android:clipToOutline="true">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/widget_pola" android:alpha="0.10" android:contentDescription="@null" />
    <ImageView android:layout_width="120dp" android:layout_height="120dp" android:layout_gravity="top|end" android:layout_marginTop="-26dp" android:layout_marginEnd="-26dp" android:src="@drawable/widget_logo" android:alpha="0.22" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="center_horizontal">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="10dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:background="@drawable/widget_lencana">
            <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/widget_pin" android:contentDescription="@null" />
            <TextView android:id="@+id/wlok" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="Jadwal shalat" android:textColor="#FFFFFFFF" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:orientation="horizontal" android:gravity="bottom">
            <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="HH:mm" android:format24Hour="HH:mm" android:textColor="#FFFFFFFF" android:textSize="40sp" android:fontFamily="sans-serif-light" android:includeFontPadding="false" android:shadowColor="#40000000" android:shadowRadius="6" />
            <TextView android:id="@+id/wzona" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:layout_marginBottom="5dp" android:text="WIB" android:textColor="#FFF1DDB0" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
        <Chronometer android:id="@+id/wnext" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
        <LinearLayout android:layout_width="210dp" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:orientation="horizontal" android:gravity="center_vertical">
            <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@drawable/widget_garis" />
            <ImageView android:layout_width="24dp" android:layout_height="16dp" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_masjid" android:contentDescription="@null" />
            <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@drawable/widget_garis" />
        </LinearLayout>
        <TextView android:id="@+id/wtgl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#F2FFFFFF" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/wkata" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="3dp" android:gravity="center" android:textColor="#F2FFFFFF" android:textSize="12sp" android:textStyle="italic" android:fontFamily="serif" android:maxLines="2" android:ellipsize="end" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
            <LinearLayout android:id="@+id/w0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="0dp" android:orientation="vertical" android:gravity="center" android:paddingTop="6dp" android:paddingBottom="6dp" android:background="@drawable/widget_ubin">
                <TextView android:id="@+id/wn0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Subuh" android:textColor="#E6FFFFFF" android:textSize="10sp" android:maxLines="1" android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/wj0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" />
            </LinearLayout>
            <LinearLayout android:id="@+id/w1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="5dp" android:orientation="vertical" android:gravity="center" android:paddingTop="6dp" android:paddingBottom="6dp" android:background="@drawable/widget_ubin">
                <TextView android:id="@+id/wn1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dzuhur" android:textColor="#E6FFFFFF" android:textSize="10sp" android:maxLines="1" android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/wj1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" />
            </LinearLayout>
            <LinearLayout android:id="@+id/w2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="5dp" android:orientation="vertical" android:gravity="center" android:paddingTop="6dp" android:paddingBottom="6dp" android:background="@drawable/widget_ubin">
                <TextView android:id="@+id/wn2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ashar" android:textColor="#E6FFFFFF" android:textSize="10sp" android:maxLines="1" android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/wj2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" />
            </LinearLayout>
            <LinearLayout android:id="@+id/w3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="5dp" android:orientation="vertical" android:gravity="center" android:paddingTop="6dp" android:paddingBottom="6dp" android:background="@drawable/widget_ubin">
                <TextView android:id="@+id/wn3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Maghrib" android:textColor="#E6FFFFFF" android:textSize="10sp" android:maxLines="1" android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/wj3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" />
            </LinearLayout>
            <LinearLayout android:id="@+id/w4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="5dp" android:orientation="vertical" android:gravity="center" android:paddingTop="6dp" android:paddingBottom="6dp" android:background="@drawable/widget_ubin">
                <TextView android:id="@+id/wn4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Isya" android:textColor="#E6FFFFFF" android:textSize="10sp" android:maxLines="1" android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/wj4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
