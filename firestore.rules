rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }

    match /users/{uid} {
      allow read, write: if owner(uid);                       // profil (data lama Agenda)
      match /absensi_harian/{day} { allow read, write: if owner(uid); }
      match /data/{doc} {                                      // sinkron antar perangkat
        allow read: if owner(uid);
        allow write: if owner(uid) && request.resource.data.keys().size() < 2000;
      }
    }

    // Pesan: pencarian persis berdasarkan email (tidak bisa di-list)
    match /userIndex/{email} {
      allow get: if signedIn();
      allow create, update: if signedIn()
        && request.auth.token.email.lower() == email
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'updated', 'pub', 'photo'])
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() <= 9000))
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.pub is string && request.resource.data.pub.size() <= 300;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /chats/{chatId} {
      // hanya boleh mengubah entri kunci publik milik sendiri
      function ownPubOnly() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pubs'])
          || request.resource.data.pubs.diff(resource.data.pubs).affectedKeys().hasOnly([request.auth.uid]);
      }
      allow get, list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && (chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
            || chatId == request.resource.data.members[1] + '_' + request.resource.data.members[0])
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.pubs[request.auth.uid] is string
        && request.resource.data.intro.size() <= 400;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.requestedBy == resource.data.requestedBy
        && (
          // pesan baru / tanda baca / memperbarui kunci publik sendiri
          (resource.data.status == 'active' && request.resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastAt', 'lastFrom', 'lastRead', 'pubs'])
            && ownPubOnly()
            && request.resource.data.lastMessage.size() <= 900)
          // penerima menerima permintaan
          || (resource.data.status == 'pending' && resource.data.requestedBy != request.auth.uid
            && request.resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastAt', 'lastRead', 'pubs'])
            && ownPubOnly())
          // blokir
          || (resource.data.status == 'active' && request.resource.data.status == 'blocked'
            && request.resource.data.blockedBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'blockedBy']))
          // buka blokir (hanya pemblokir)
          || (resource.data.status == 'blocked' && resource.data.blockedBy == request.auth.uid
            && request.resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'blockedBy']))
        );
      allow delete: if signedIn() && request.auth.uid in resource.data.members;

      match /messages/{mid} {
        function chat() { return get(/databases/$(database)/documents/chats/$(chatId)).data; }
        allow read: if signedIn() && request.auth.uid in chat().members;
        allow create: if signedIn()
          && request.auth.uid in chat().members && chat().status == 'active'
          && request.resource.data.keys().hasOnly(['from', 'text', 'at', 'expireAt'])
          && (!('expireAt' in request.resource.data) || request.resource.data.expireAt is timestamp)
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 9000
          && request.resource.data.at == request.time;
        allow delete: if signedIn() && resource.data.from == request.auth.uid;
      }
    }

    // Laporan bug & saran dari menu Bantuan: siapa pun boleh mengirim (bentuk dan ukuran dibatasi),
    // hanya admin (lihat /admin.html) yang boleh membaca, mengubah status, atau menghapus
    function admin() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email in ['hilmykia@gmail.com'];
    }
    match /reports/{id} {
      allow create: if request.resource.data.keys().hasOnly(['type', 'name', 'text', 'page', 'ua', 'ver', 'uid', 'email', 'at', 'status', 'shots'])
        && request.resource.data.type in ['bug', 'saran']
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.text is string && request.resource.data.text.size() >= 10 && request.resource.data.text.size() <= 2000
        && request.resource.data.status == 'baru'
        && request.resource.data.at == request.time
        && request.resource.data.shots is list && request.resource.data.shots.size() <= 3
        && (request.resource.data.uid == null || (request.auth != null && request.resource.data.uid == request.auth.uid))
        && (request.resource.data.email == null || (request.auth != null && request.resource.data.email == request.auth.token.email));
      allow read, delete: if admin();
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note']);
    }

    // Catatan akun untuk dasbor admin (nama, email, merek HP, kota): ditulis pemilik akun, dibaca hanya oleh admin
    match /akun/{uid} {
      function bentuk() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid', 'email', 'name', 'brand', 'model', 'os', 'app', 'ver', 'kota', 'ipkota', 'lat', 'lng', 'first', 'last'])
          && d.uid == uid && d.last == request.time
          && (d.email == null || d.email == request.auth.token.email)
          && d.name is string && d.name.size() <= 80
          && d.brand is string && d.brand.size() <= 80 && d.model is string && d.model.size() <= 80
          && d.os is string && d.os.size() <= 80 && d.app in ['APK', 'Web']
          && d.ver is string && d.ver.size() <= 80 && d.kota is string && d.kota.size() <= 80
          && (!('ipkota' in d) || (d.ipkota is string && d.ipkota.size() <= 80))
          && d.lat is number && d.lng is number;
      }
      allow get, delete: if owner(uid) || admin();
      allow list: if admin();
      allow create: if owner(uid) && bentuk() && request.resource.data.first == request.time;
      allow update: if owner(uid) && bentuk() && request.resource.data.first == resource.data.first;
    }

    // Pengunjung (tanpa login juga): ID acak per perangkat, HP, kota perkiraan, sumber link, jumlah kunjungan.
    // Nama & email hanya boleh diisi oleh pemilik akun yang sedang login. Hanya admin yang boleh membaca.
    match /kunjungan/{vid} {
      function bentukK() {
        let d = request.resource.data;
        return d.keys().hasOnly(['vid', 'uid', 'email', 'name', 'brand', 'model', 'os', 'app', 'ver', 'kota', 'ipkota', 'ref', 'ref1', 'masuk', 'n', 'first', 'last'])
          && d.vid == vid && vid.matches('^[a-z0-9]{20}$') && d.last == request.time
          && d.brand is string && d.brand.size() <= 80 && d.model is string && d.model.size() <= 80
          && d.os is string && d.os.size() <= 80 && d.app in ['APK', 'Web'] && d.ver is string && d.ver.size() <= 80
          && d.kota is string && d.kota.size() <= 80 && d.ipkota is string && d.ipkota.size() <= 80
          && d.ref is string && d.ref.size() <= 120 && d.ref1 is string && d.ref1.size() <= 120
          && d.masuk is string && d.masuk.size() <= 120 && d.n is int;
      }
      function siapa() {
        let d = request.resource.data;
        return (d.uid == null || (request.auth != null && d.uid == request.auth.uid))
          && (d.email == null || (request.auth != null && d.email == request.auth.token.email))
          && (d.name == null || (d.name is string && d.name.size() <= 80));
      }
      function tetap(k) { return request.resource.data[k] == resource.data[k]; }
      allow create: if bentukK() && siapa() && request.resource.data.n == 1 && request.resource.data.first == request.time;
      allow update: if bentukK() && tetap('first') && tetap('ref1')
        && (request.resource.data.n == resource.data.n || request.resource.data.n == resource.data.n + 1)
        && (siapa() || (tetap('uid') && tetap('email') && tetap('name')));
      allow get, list: if admin();
      allow delete: if admin() || (request.auth != null && resource.data.uid == request.auth.uid);
    }

    match /{document=**} { allow read, write: if false; }
  }
}
