{"surah":107,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","tj":[50,51,4,70,71,4,71,72,4,75,76,3]},{"id":2,"text":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","tj":[4,5,3,10,11,4,26,27,4,33,34,3]},{"id":3,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","tj":[29,30,4,38,39,3]},{"id":4,"text":"فَوَيْلٌ لِّلْمُصَلِّينَ","tj":[7,12,1,21,22,3]},{"id":5,"text":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","tj":[17,21,1,36,37,3]},{"id":6,"text":"ٱلَّذِينَ هُمْ يُرَآءُونَ","tj":[19,21,3,23,24,3]},{"id":7,"text":"وَيَمْنَعُونَ ٱلْمَاعُونَ","tj":[14,15,4,22,23,3]}]}