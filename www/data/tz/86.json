{"surah":86,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ","tj":[41,42,4,42,43,4,48,50,3,55,56,4,56,57,4,63,64,2]},{"id":2,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ","tj":[4,6,3,9,11,2,14,15,3,22,23,4,23,24,4,30,31,2]},{"id":3,"text":"ٱلنَّجْمُ ٱلثَّاقِبُ","tj":[1,2,4,2,5,1,5,7,2,10,11,4,11,12,4,18,19,2]},{"id":4,"text":"إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ","tj":[2,6,1,15,20,1,20,23,1]},{"id":5,"text":"فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ","tj":[6,9,1,12,13,4,17,20,1,20,21,3,26,29,1,34,35,2]},{"id":6,"text":"خُلِقَ مِن مَّآءٍ دَافِقٍ","tj":[9,14,1,14,16,3,17,21,1,24,25,2]},{"id":7,"text":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ","tj":[12,15,1,21,22,4,22,23,4,33,34,4,34,35,4,40,42,3,44,45,2]},{"id":8,"text":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ","tj":[2,5,1,7,8,3,18,20,2,24,25,3]},{"id":9,"text":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ","tj":[9,11,2,15,16,4,16,17,4,22,24,3]},{"id":10,"text":"فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ","tj":[10,11,3,14,18,1,22,26,1]},{"id":11,"text":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ","tj":[2,3,4,3,4,4,9,11,3,20,21,4,21,22,4,25,27,2]},{"id":12,"text":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ","tj":[2,3,4,18,19,4,19,20,4,23,25,2]},{"id":13,"text":"إِنَّهُۥ لَقَوْلٌ فَصْلٌ","tj":[2,5,1,7,8,3,16,20,1]},{"id":14,"text":"وَمَا هُوَ بِٱلْهَزْلِ","tj":[13,14,4]},{"id":15,"text":"إِنَّهُمْ يَكِيدُونَ كَيْدًا","tj":[2,5,1]},{"id":16,"text":"وَأَكِيدُ كَيْدًا","tj":[]},{"id":17,"text":"فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا","tj":[10,11,4,15,16,3]}]}