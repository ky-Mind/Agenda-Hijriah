{"surah":68,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ نٓ وَٱلْقَلَمِ وَمَا يَسْطُرُونَ","tj":[39,41,3,44,45,4,68,69,3]},{"id":2,"text":"مَآ أَنتَ بِنِعْمَةِ رَبِّكَ بِمَجْنُونٍ","tj":[2,4,3,7,10,1,34,36,2,38,39,3]},{"id":3,"text":"وَإِنَّ لَكَ لَأَجْرًا غَيْرَ مَمْنُونٍ","tj":[4,7,1,17,19,2,36,37,3]},{"id":4,"text":"وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍ","tj":[4,7,1,30,31,3]},{"id":5,"text":"فَسَتُبْصِرُ وَيُبْصِرُونَ","tj":[6,8,2,17,19,2,23,24,3]},{"id":6,"text":"بِأَييِّكُمُ ٱلْمَفْتُونُ","tj":[13,14,4,22,23,3]},{"id":7,"text":"إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعْلَمُ بِٱلْمُهْتَدِينَ","tj":[2,5,1,32,36,1,42,46,1,53,54,3,73,74,4,84,85,3]},{"id":8,"text":"فَلَا تُطِعِ ٱلْمُكَذِّبِينَ","tj":[13,14,4,25,26,3]},{"id":9,"text":"وَدُّوا۟ لَوْ تُدْهِنُ فَيُدْهِنُونَ","tj":[6,8,4,16,18,2,27,29,2,33,34,3]},{"id":10,"text":"وَلَا تُطِعْ كُلَّ حَلَّافٍ مَّهِينٍ","tj":[26,31,1,33,34,3]},{"id":11,"text":"هَمَّازٍ مَّشَّآءٍۭ بِنَمِيمٍ","tj":[2,5,1,7,12,1,15,17,3,18,22,1,27,28,3]},{"id":12,"text":"مَّنَّاعٍ لِّلْخَيْرِ مُعْتَدٍ أَثِيمٍ","tj":[3,6,1,8,13,1,35,36,3]},{"id":13,"text":"عُتُلٍّۭ بَعْدَ ذَٰلِكَ زَنِيمٍ","tj":[6,10,1,18,19,3,28,29,3]},{"id":14,"text":"أَن كَانَ ذَا مَالٍ وَبَنِينَ","tj":[2,6,1,18,22,1,26,27,3]},{"id":15,"text":"إِذَا تُتْلَىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلْأَوَّلِينَ","tj":[29,30,3,46,47,3,53,54,4,63,64,3]},{"id":16,"text":"سَنَسِمُهُۥ عَلَى ٱلْخُرْطُومِ","tj":[10,11,3,18,19,4,27,28,3]},{"id":17,"text":"إِنَّا بَلَوْنَٰهُمْ كَمَا بَلَوْنَآ أَصْحَٰبَ ٱلْجَنَّةِ إِذْ أَقْسَمُوا۟ لَيَصْرِمُنَّهَا مُصْبِحِينَ","tj":[2,5,1,15,16,3,35,37,3,44,45,3,48,49,4,53,56,1,66,68,2,73,75,4,86,89,1,101,102,3]},{"id":18,"text":"وَلَا يَسْتَثْنُونَ","tj":[16,17,3]},{"id":19,"text":"فَطَافَ عَلَيْهَا طَآئِفٌ مِّن رَّبِّكَ وَهُمْ نَآئِمُونَ","tj":[20,22,3,25,30,1,30,35,1,50,52,3,56,57,3]},{"id":20,"text":"فَأَصْبَحَتْ كَٱلصَّرِيمِ","tj":[15,16,4,16,17,4,22,23,3]},{"id":21,"text":"فَتَنَادَوْا۟ مُصْبِحِينَ","tj":[11,13,4,22,23,3]},{"id":22,"text":"أَنِ ٱغْدُوا۟ عَلَىٰ حَرْثِكُمْ إِن كُنتُمْ صَٰرِمِينَ","tj":[5,6,4,11,13,4,34,38,1,38,41,1,46,47,3,51,52,3]},{"id":23,"text":"فَٱنطَلَقُوا۟ وَهُمْ يَتَخَٰفَتُونَ","tj":[2,3,4,3,6,1,11,13,4,27,28,3,32,33,3]},{"id":24,"text":"أَن لَّا يَدْخُلَنَّهَا ٱلْيَوْمَ عَلَيْكُم مِّسْكِينٌ","tj":[2,7,1,11,13,2,17,20,1,24,25,4,42,47,1,51,52,3]},{"id":25,"text":"وَغَدَوْا۟ عَلَىٰ حَرْدٍ قَٰدِرِينَ","tj":[8,10,4,23,27,1,27,28,3,32,33,3]},{"id":26,"text":"فَلَمَّا رَأَوْهَا قَالُوٓا۟ إِنَّا لَضَآلُّونَ","tj":[4,7,1,24,26,3,26,28,4,31,34,1,40,42,3,45,46,3]},{"id":27,"text":"بَلْ نَحْنُ مَحْرُومُونَ","tj":[21,22,3]},{"id":28,"text":"قَالَ أَوْسَطُهُمْ أَلَمْ أَقُل لَّكُمْ لَوْلَا تُسَبِّحُونَ","tj":[57,58,3]},{"id":29,"text":"قَالُوا۟ سُبْحَٰنَ رَبِّنَآ إِنَّا كُنَّا ظَٰلِمِينَ","tj":[6,8,4,11,13,2,15,16,3,26,28,3,31,34,1,38,41,1,45,46,3,50,51,3]},{"id":30,"text":"فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَلَٰوَمُونَ","tj":[4,6,2,34,38,1,42,43,3,47,48,3]},{"id":31,"text":"قَالُوا۟ يَٰوَيْلَنَآ إِنَّا كُنَّا طَٰغِينَ","tj":[6,8,4,11,12,3,20,22,3,25,28,1,32,35,1,39,40,3,42,43,3]},{"id":32,"text":"عَسَىٰ رَبُّنَآ أَن يُبْدِلَنَا خَيْرًا مِّنْهَآ إِنَّآ إِلَىٰ رَبِّنَا رَٰغِبُونَ","tj":[14,16,3,19,23,1,23,25,2,38,44,1,48,50,3,53,56,1,56,58,3,77,78,3,82,83,3]},{"id":33,"text":"كَذَٰلِكَ ٱلْعَذَابُ وَلَعَذَابُ ٱلْـَٔاخِرَةِ أَكْبَرُ لَوْ كَانُوا۟ يَعْلَمُونَ","tj":[4,5,3,10,11,4,33,34,4,66,68,4,77,78,3]},{"id":34,"text":"إِنَّ لِلْمُتَّقِينَ عِندَ رَبِّهِمْ جَنَّٰتِ ٱلنَّعِيمِ","tj":[2,5,1,23,26,1,39,42,1,42,43,3,46,47,4,47,48,4,48,51,1,53,54,3]},{"id":35,"text":"أَفَنَجْعَلُ ٱلْمُسْلِمِينَ كَٱلْمُجْرِمِينَ","tj":[6,8,2,13,14,4,30,31,4,35,37,2,41,42,3]},{"id":36,"text":"مَا لَكُمْ كَيْفَ تَحْكُمُونَ","tj":[26,27,3]},{"id":37,"text":"أَمْ لَكُمْ كِتَٰبٌ فِيهِ تَدْرُسُونَ","tj":[16,17,3,18,22,1,28,30,2,34,35,3]},{"id":38,"text":"إِنَّ لَكُمْ فِيهِ لَمَا تَخَيَّرُونَ","tj":[2,5,1,34,35,3]},{"id":39,"text":"أَمْ لَكُمْ أَيْمَٰنٌ عَلَيْنَا بَٰلِغَةٌ إِلَ