{"surah":79,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلنَّٰزِعَٰتِ غَرْقًا","tj":[41,42,4,42,43,4,43,46,1,46,47,3,51,52,3]},{"id":2,"text":"وَٱلنَّٰشِطَٰتِ نَشْطًا","tj":[2,3,4,3,4,4,4,7,1,7,8,3,12,13,3]},{"id":3,"text":"وَٱلسَّٰبِحَٰتِ سَبْحًا","tj":[2,3,4,3,4,4,7,8,3,12,13,3,18,20,2]},{"id":4,"text":"فَٱلسَّٰبِقَٰتِ سَبْقًا","tj":[2,3,4,3,4,4,7,8,3,12,13,3,18,20,2]},{"id":5,"text":"فَٱلْمُدَبِّرَٰتِ أَمْرًا","tj":[2,3,4,14,15,3]},{"id":6,"text":"يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ","tj":[16,17,4,17,18,4]},{"id":7,"text":"تَتْبَعُهَا ٱلرَّادِفَةُ","tj":[12,13,4,13,14,4]},{"id":8,"text":"قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ","tj":[6,10,1,17,21,1]},{"id":9,"text":"أَبْصَٰرُهَا خَٰشِعَةٌ","tj":[2,4,2,6,7,3,15,16,3]},{"id":10,"text":"يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ","tj":[15,18,1,39,40,4]},{"id":11,"text":"أَءِذَا كُنَّا عِظَٰمًا نَّخِرَةً","tj":[10,13,1,19,20,3,21,27,1]},{"id":12,"text":"قَالُوا۟ تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ","tj":[6,8,4,19,24,1]},{"id":13,"text":"فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ","tj":[4,7,1,18,20,2,23,27,1,27,28,3]},{"id":14,"text":"فَإِذَا هُم بِٱلسَّاهِرَةِ","tj":[10,14,1,14,15,4,15,16,4]},{"id":15,"text":"هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ","tj":[10,11,3]},{"id":16,"text":"إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى","tj":[11,12,3,22,23,3,26,27,4,35,36,4]},{"id":17,"text":"ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ","tj":[5,7,2,28,31,1,33,34,3]},{"id":18,"text":"فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ","tj":[21,24,3,27,31,1]},{"id":19,"text":"وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ","tj":[]},{"id":20,"text":"فَأَرَىٰهُ ٱلْـَٔايَةَ ٱلْكُبْرَىٰ","tj":[7,8,3,11,12,4,22,23,4,27,29,2]},{"id":21,"text":"فَكَذَّبَ وَعَصَىٰ","tj":[]},{"id":22,"text":"ثُمَّ أَدْبَرَ يَسْعَىٰ","tj":[2,5,1,8,10,2]},{"id":23,"text":"فَحَشَرَ فَنَادَىٰ","tj":[]},{"id":24,"text":"فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ","tj":[25,26,4]},{"id":25,"text":"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْـَٔاخِرَةِ وَٱلْأُولَىٰٓ","tj":[11,12,4,27,28,4,42,43,4]},{"id":26,"text":"إِنَّ فِى ذَٰلِكَ لَعِبْرَةً لِّمَن يَخْشَىٰٓ","tj":[2,5,1,12,13,3,22,24,2,27,32,1,34,38,1]},{"id":27,"text":"ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ بَنَىٰهَا","tj":[4,7,1,31,32,4,32,33,4,38,40,3,48,49,3]},{"id":28,"text":"رَفَعَ سَمْكَهَا فَسَوَّىٰهَا","tj":[25,26,3]},{"id":29,"text":"وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا","tj":[37,38,3]},{"id":30,"text":"وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ","tj":[2,3,4,21,22,3,32,33,3]},{"id":31,"text":"أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا","tj":[19,21,3,36,37,3]},{"id":32,"text":"وَٱلْجِبَالَ أَرْسَىٰهَا","tj":[2,3,4,20,21,3]},{"id":33,"text":"مَتَٰعًا لَّكُمْ وَلِأَنْعَٰمِكُمْ","tj":[4,5,3,6,12,1,27,28,3]},{"id":34,"text":"فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ","tj":[10,12,3,17,18,4,18,19,4,22,24,3,24,27,1,30,31,4,35,37,2]},{"id":35,"text":"يَوْمَ يَتَذَكَّرُ ٱلْإِنسَٰنُ مَا سَعَىٰ","tj":[19,20,4,24,27,1,27,28,3]},{"id":36,"text":"وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ","tj":[12,13,4,27,31,1]},{"id":37,"text":"فَأَمَّا مَن طَغَىٰ","tj":[4,7,1,11,15,1]},{"id":38,"text":"وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","tj":[10,11,4,17,18,4,18,19,3,22,23,4,23,24,4]},{"id":39,"text":"فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ","tj":[4,7,1,8,9,4,24,25,4]},{"id":40,"text":"وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ","tj":[4,7,1,35,36,3,45,46,4,46,47,4,47,50,1,60,61,4]},{"id":41,"text":"فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ","tj":[4,7,1,8,9,4,13,16,1,24,25,4]},{"id":42,"text":"يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا","tj":[20,21,4,21,22,4,47,48,3]},{"id":43,"text":"فِيمَ أَنتَ مِن ذِكْرَىٰهَآ","tj":[8,11,1,14,18,1,23,24,3]},{"id":44,"text":"إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ","tj":[17,20,1,23,24,3]},{"id":45,"text":"إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا","tj":[2,5,1,7,9,3,12,15,1,18,21,1,26,30,1,35,36,3]},{"id":46,"text":"كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا","tj":[4,7,1,44,46,3,46,48,4,76,77,3]}]}