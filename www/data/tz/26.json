{"surah":26,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ طسٓمٓ","tj":[40,42,3,42,44,3]},{"id":2,"text":"تِلْكَ ءَايَٰتُ ٱلْكِتَٰبِ ٱلْمُبِينِ","tj":[12,13,3,16,17,4,23,24,3,27,28,4,34,35,3]},{"id":3,"text":"لَعَلَّكَ بَٰخِعٌ نَّفْسَكَ أَلَّا يَكُونُوا۟ مُؤْمِنِينَ","tj":[12,13,3,16,21,1,43,45,4,54,55,3]},{"id":4,"text":"إِن نَّشَأْ نُنَزِّلْ عَلَيْهِم مِّنَ ٱلسَّمَآءِ ءَايَةً فَظَلَّتْ أَعْنَٰقُهُمْ لَهَا خَٰضِعِينَ","tj":[2,7,1,30,35,1,38,39,4,39,40,4,45,47,3,56,60,1,74,75,3,90,91,3,95,96,3]},{"id":5,"text":"وَمَا يَأْتِيهِم مِّن ذِكْرٍ مِّنَ ٱلرَّحْمَٰنِ مُحْدَثٍ إِلَّا كَانُوا۟ عَنْهُ مُعْرِضِينَ","tj":[15,20,1,20,24,1,27,32,1,35,36,4,36,37,4,44,45,3,70,72,4,88,89,3]},{"id":6,"text":"فَقَدْ كَذَّبُوا۟ فَسَيَأْتِيهِمْ أَنۢبَٰٓؤُا۟ مَا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ","tj":[4,6,2,15,17,4,37,39,1,40,42,3,44,46,4,57,59,4,64,65,3,78,79,3]},{"id":7,"text":"أَوَلَمْ يَرَوْا۟ إِلَى ٱلْأَرْضِ كَمْ أَنۢبَتْنَا فِيهَا مِن كُلِّ زَوْجٍ كَرِيمٍ","tj":[15,17,4,24,25,4,42,44,1,60,64,1,73,77,1,79,80,3]},{"id":8,"text":"إِنَّ فِى ذَٰلِكَ لَـَٔايَةً وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ","tj":[2,5,1,12,13,3,26,30,1,50,55,1,61,62,3]},{"id":9,"text":"وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ","tj":[4,7,1,23,24,4,34,35,4,35,36,4,41,42,3]},{"id":10,"text":"وَإِذْ نَادَىٰ رَبُّكَ مُوسَىٰٓ أَنِ ٱئْتِ ٱلْقَوْمَ ٱلظَّٰلِمِينَ","tj":[28,31,3,37,38,4,43,44,4,53,54,4,54,55,4,58,59,3,63,64,3]},{"id":11,"text":"قَوْمَ فِرْعَوْنَ أَلَا يَتَّقُونَ","tj":[31,32,3]},{"id":12,"text":"قَالَ رَبِّ إِنِّىٓ أَخَافُ أَن يُكَذِّبُونِ","tj":[14,17,1,17,19,3,30,34,1,41,42,3]},{"id":13,"text":"وَيَضِيقُ صَدْرِى وَلَا يَنطَلِقُ لِسَانِى فَأَرْسِلْ إِلَىٰ هَٰرُونَ","tj":[12,14,2,26,29,1,63,64,3,66,67,3]},{"id":14,"text":"وَلَهُمْ عَلَىَّ ذَنۢبٌ فَأَخَافُ أَن يَقْتُلُونِ","tj":[20,22,1,22,26,1,36,40,1,40,42,2,46,47,3]},{"id":15,"text":"قَالَ كَلَّا فَٱذْهَبَا بِـَٔايَٰتِنَآ إِنَّا مَعَكُم مُّسْتَمِعُونَ","tj":[15,16,4,32,33,3,37,39,3,42,45,1,53,58,1,66,67,3]},{"id":16,"text":"فَأْتِيَا ف