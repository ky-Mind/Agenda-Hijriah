{"surah":83,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌ لِّلْمُطَفِّفِينَ","tj":[44,49,1,60,61,3]},{"id":2,"text":"ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ","tj":[16,17,4,25,27,4,34,35,4,35,36,4,36,39,1,53,54,3]},{"id":3,"text":"وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ","tj":[44,45,3]},{"id":4,"text":"أَلَا يَظُنُّ أُو۟لَٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ","tj":[10,13,1,16,18,4,20,22,3,29,32,1,34,39,1,39,41,2,46,47,3]},{"id":5,"text":"لِيَوْمٍ عَظِيمٍ","tj":[13,14,3]},{"id":6,"text":"يَوْمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلْعَٰلَمِينَ","tj":[15,16,4,16,17,4,17,20,1,32,33,4,37,38,3,42,43,3]},{"id":7,"text":"كَلَّآ إِنَّ كِتَٰبَ ٱلْفُجَّارِ لَفِى سِجِّينٍ","tj":[5,7,3,10,13,1,18,19,3,22,23,4,45,46,3]},{"id":8,"text":"وَمَآ أَدْرَىٰكَ مَا سِجِّينٌ","tj":[4,6,3,9,11,2,14,15,3,27,28,3]},{"id":9,"text":"كِتَٰبٌ مَّرْقُومٌ","tj":[4,5,3,6,11,1,15,16,3]},{"id":10,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","tj":[5,9,1,16,21,1,32,33,3]},{"id":11,"text":"ٱلَّذِينَ يُكَذِّبُونَ بِيَوْمِ ٱلدِّينِ","tj":[32,33,4,33,34,4,37,38,3]},{"id":12,"text":"وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعْتَدٍ أَثِيمٍ","tj":[20,22,3,49,50,3]},{"id":13,"text":"إِذَا تُتْلَىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلْأَوَّلِينَ","tj":[29,30,3,46,47,3,53,54,4,63,64,3]},{"id":14,"text":"كَلَّا بَلْ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُوا۟ يَكْسِبُونَ","tj":[34,39,1,47,49,4,58,59,3]},{"id":15,"text":"كَلَّآ إِنَّهُمْ عَن رَّبِّهِمْ يَوْمَئِذٍ لَّمَحْجُوبُونَ","tj":[5,7,3,10,13,1,20,25,1,42,47,1,56,57,3]},{"id":16,"text":"ثُمَّ إِنَّهُمْ لَصَالُوا۟ ٱلْجَحِيمِ","tj":[2,5,1,8,11,1,24,26,4,27,28,4,34,35,3]},{"id":17,"text":"ثُمَّ يُقَالُ هَٰذَا ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ","tj":[2,5,1,16,17,3,21,22,4,31,34,1,34,38,1,40,41,3,51,52,3]},{"id":18,"text":"كَلَّآ إِنَّ كِتَٰبَ ٱلْأَبْرَارِ لَفِى عِلِّيِّينَ","tj":[5,7,3,10,13,1,18,19,3,22,23,4,27,29,2,49,50,3]},{"id":19,"text":"وَمَآ أَدْرَىٰكَ مَا عِلِّيُّونَ","tj":[4,6,3,9,11,2,14,15,3,30,31,3]},{"id":20,"text":"كِتَٰبٌ مَّرْقُومٌ","tj":[4,5,3,6,11,1,15,16,3]},{"id":21,"text":"يَشْهَدُهُ ٱلْمُقَرَّبُونَ","tj":[11,12,4,23,24,3]},{"id":22,"text":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ","tj":[2,5,1,6,7,4,11,13,2,29,30,3]},{"id":23,"text":"عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ","tj":[6,7,4,13,15,3,22,25,1,27,28,3]},{"id":24,"text":"تَعْرِفُ فِى وُجُوهِهِمْ نَضْرَةَ ٱلنَّعِيمِ","tj":[34,35,4,35,36,4,36,39,1,41,42,3]},{"id":25,"text":"يُسْقَوْنَ مِن رَّحِيقٍ مَّخْتُومٍ","tj":[13,18,1,22,27,1,31,32,3]},{"id":26,"text":"خِتَٰمُهُۥ مِسْكٌ وَفِى ذَٰلِكَ فَلْيَتَنَافَسِ ٱلْمُتَنَٰفِسُونَ","tj":[4,5,3,9,10,3,16,20,1,26,27,3,48,49,4,57,58,3,62,63,3]},{"id":27,"text":"وَمِزَاجُهُۥ مِن تَسْنِيمٍ","tj":[11,12,3,15,19,1,23,24,3]},{"id":28,"text":"عَيْنًا يَشْرَبُ بِهَا ٱلْمُقَرَّبُونَ","tj":[5,10,1,23,24,4,35,36,3]},{"id":29,"text":"إِنَّ ٱلَّذِينَ أَجْرَمُوا۟ كَانُوا۟ مِنَ ٱلَّذِينَ ءَامَنُوا۟ يَضْحَكُونَ","tj":[2,5,1,6,7,4,18,20,2,25,27,4,34,36,4,42,43,4,60,62,4,71,72,3]},{"id":30,"text":"وَإِذَا مَرُّوا۟ بِهِمْ يَتَغَامَزُونَ","tj":[14,16,4,35,36,3]},{"id":31,"text":"وَإِذَا ٱنقَلَبُوٓا۟ إِلَىٰٓ أَهْلِهِمُ ٱنقَلَبُوا۟ فَكِهِينَ","tj":[8,9,4,9,12,1,16,18,3,18,20,4,25,28,3,40,41,4,41,44,1,49,51,4,58,59,3]},{"id":32,"text":"وَإِذَا رَأَوْهُمْ قَالُوٓا۟ إِنَّ هَٰٓؤُلَآءِ لَضَآلُّونَ","tj":[24,26,3,26,28,4,31,34,1,37,39,3,43,45,3,52,54,3,57,58,3]},{"id":33,"text":"وَمَآ أُرْسِلُوا۟ عَلَيْهِمْ حَٰفِظِينَ","tj":[4,6,3,16,18,4,32,33,3,37,38,3]},{"id":34,"text":"فَٱلْيَوْمَ ٱلَّذِينَ ءَامَنُوا۟ مِنَ ٱلْكُفَّارِ يَضْحَكُونَ","tj":[2,3,4,12,13,4,30,32,4,38,39,4,58,59,3]},{"id":35,"text":"عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ","tj":[6,7,4,13,15,3,22,25,1,27,28,3]},{"id":36,"text":"هَلْ ثُوِّبَ ٱلْكُفَّارُ مَا كَانُوا۟ يَفْعَلُونَ","tj":[13,14,4,35,37,4,46,47,3]}]}