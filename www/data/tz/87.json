{"surah":87,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى","tj":[47,48,4,61,62,4]},{"id":2,"text":"ٱلَّذِى خَلَقَ فَسَوَّىٰ","tj":[]},{"id":3,"text":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ","tj":[2,3,4]},{"id":4,"text":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ","tj":[2,3,4,8,10,3,20,21,4]},{"id":5,"text":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ","tj":[10,11,3,16,18,3]},{"id":6,"text":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ","tj":[4,6,2,21,24,1]},{"id":7,"text":"إِلَّا مَا شَآءَ ٱللَّهُ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ","tj":[13,15,3,18,19,4,28,31,1,33,34,3,44,45,4]},{"id":8,"text":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ","tj":[]},{"id":9,"text":"فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ","tj":[12,17,1,24,25,4,25,26,4]},{"id":10,"text":"سَيَذَّكَّرُ مَن يَخْشَىٰ","tj":[15,19,1]},{"id":11,"text":"وَيَتَجَنَّبُهَا ٱلْأَشْقَى","tj":[8,11,1,17,18,4]},{"id":12,"text":"ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ","tj":[16,17,4,17,18,4,18,21,1,25,26,4,30,32,2]},{"id":13,"text":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ","tj":[2,5,1]},{"id":14,"text":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ","tj":[2,4,2,16,20,1]},{"id":15,"text":"وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ","tj":[9,10,4,22,23,3]},{"id":16,"text":"بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","tj":[17,18,4,24,25,4,25,26,3,29,30,4,30,31,4]},{"id":17,"text":"وَٱلْـَٔاخِرَةُ خَيْرٌ وَأَبْقَىٰٓ","tj":[2,3,4,20,24,1,26,28,2]},{"id":18,"text":"إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ","tj":[2,5,1,8,9,3,19,20,4,20,21,4,29,30,4]},{"id":19,"text":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ","tj":[9,11,2,13,14,3]}]}