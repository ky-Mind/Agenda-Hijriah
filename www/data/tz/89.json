{"surah":89,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْفَجْرِ","tj":[41,42,4,46,48,2]},{"id":2,"text":"وَلَيَالٍ عَشْرٍ","tj":[]},{"id":3,"text":"وَٱلشَّفْعِ وَٱلْوَتْرِ","tj":[2,3,4,3,4,4,14,15,4]},{"id":4,"text":"وَٱلَّيْلِ إِذَا يَسْرِ","tj":[2,3,4]},{"id":5,"text":"هَلْ فِى ذَٰلِكَ قَسَمٌ لِّذِى حِجْرٍ","tj":[11,12,3,22,27,1,33,35,2]},{"id":6,"text":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ","tj":[38,39,3,39,40,2]},{"id":7,"text":"إِرَمَ ذَاتِ ٱلْعِمَادِ","tj":[13,14,4,20,21,3,21,22,2]},{"id":8,"text":"ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَٰدِ","tj":[19,21,2,36,37,4,43,44,3,44,45,2]},{"id":9,"text":"وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ","tj":[10,11,4,26,28,4,29,30,4,30,31,4,41,42,4,46,47,3,47,48,2]},{"id":10,"text":"وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ","tj":[17,18,4,26,27,3,27,28,2]},{"id":11,"text":"ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَٰدِ","tj":[16,18,4,23,24,4,30,31,3,31,32,2]},{"id":12,"text":"فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ","tj":[11,13,4,21,22,4,28,29,3,29,30,2]},{"id":13,"text":"فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ","tj":[38,39,3,39,40,2]},{"id":14,"text":"إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ","tj":[2,5,1,18,19,4,27,28,3,28,29,2]},{"id":15,"text":"فَأَمَّا ٱلْإِنسَٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ","tj":[4,7,1,9,10,4,14,17,1,17,18,3,31,32,4,32,34,2,39,40,3,50,51,3,64,65,3,77,78,3,94,96,3]},{"id":16,"text":"وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَٰنَنِ","tj":[4,7,1,7,9,3,20,21,4,21,23,2,28,29,3,58,59,3,75,77,3,82,83,3]},{"id":17,"text":"كَلَّا بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ","tj":[28,29,4,35,36,3]},{"id":18,"text":"وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","tj":[10,12,3,34,35,4,43,44,3]},{"id":19,"text":"وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًا لَّمًّا","tj":[14,15,4,15,16,4,30,36,1,36,39,1]},{"id":20,"text":"وَتُحِبُّونَ ٱلْمَالَ حُبًّا جَمًّا","tj":[13,14,4,26,31,1,31,34,1]},{"id":21,"text":"كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّا دَكًّا","tj":[5,7,3,22,23,4,36,41,1]},{"id":22,"text":"وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّا صَفًّا","tj":[4,6,3,19,20,4,33,38,1]},{"id":23,"text":"وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ يَوْمَئِذٍ يَتَذَكَّرُ ٱلْإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ","tj":[4,6,4,6,8,3,20,24,1,29,32,1,44,48,1,58,59,4,63,66,1,66,67,3,74,77,1,85,86,4,86,87,4]},{"id":24,"text":"يَقُولُ يَٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى","tj":[10,11,3]},{"id":25,"text":"فَيَوْمَئِذٍ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌ","tj":[11,16,1,37,39,3,44,45,2]},{"id":26,"text":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌ","tj":[23,25,3,30,31,2]},{"id":27,"text":"يَٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ","tj":[2,4,3,15,16,4,16,17,4,17,20,1,25,26,4,30,32,2,36,39,1]},{"id":28,"text":"ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةً مَّرْضِيَّةً","tj":[7,9,3,33,38,1]},{"id":29,"text":"فَٱدْخُلِى فِى عِبَٰدِى","tj":[2,3,4,3,5,2,19,20,3]},{"id":30,"text":"وَٱدْخُلِى جَنَّتِى","tj":[2,3,4,3,5,2,13,16,1]}]}