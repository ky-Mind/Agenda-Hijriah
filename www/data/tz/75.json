{"surah":75,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ","tj":[41,43,3,46,48,2,62,63,4,69,70,3]},{"id":2,"text":"وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ","tj":[4,6,3,9,11,2,18,19,4,19,20,4,20,23,1,28,29,4,29,30,4]},{"id":3,"text":"أَيَحْسَبُ ٱلْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ","tj":[11,12,4,16,19,1,19,20,3,28,33,1,33,35,2]},{"id":4,"text":"بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ","tj":[9,10,3,22,25,3,28,33,1]},{"id":5,"text":"بَلْ يُرِيدُ ٱلْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥ","tj":[13,14,4,18,21,1,21,22,3]},{"id":6,"text":"يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَٰمَةِ","tj":[26,27,4,33,34,3]},{"id":7,"text":"فَإِذَا بَرِقَ ٱلْبَصَرُ","tj":[15,16,4]},{"id":8,"text":"وَخَسَفَ ٱلْقَمَرُ","tj":[9,10,4]},{"id":9,"text":"وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ","tj":[9,10,4,10,11,4,21,22,4]},{"id":10,"text":"يَقُولُ ٱلْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ","tj":[8,9,4,13,16,1,16,17,3,38,39,4]},{"id":11,"text":"كَلَّا لَا وَزَرَ","tj":[]},{"id":12,"text":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ","tj":[26,27,4]},{"id":13,"text":"يُنَبَّؤُا۟ ٱلْإِنسَٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ","tj":[9,11,4,12,13,4,17,20,1,20,21,3,33,37,1]},{"id":14,"text":"بَلِ ٱلْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌ","tj":[5,6,4,10,13,1,13,14,3,32,33,3]},{"id":15,"text":"وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ","tj":[]},{"id":16,"text":"لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ","tj":[18,19,3]},{"id":17,"text":"إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ","tj":[2,5,1,24,25,3]},{"id":18,"text":"فَإِذَا قَرَأْنَٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ","tj":[16,17,3,22,23,4]},{"id":19,"text":"ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ","tj":[2,5,1,8,11,1]},{"id":20,"text":"كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ","tj":[23,24,4]},{"id":21,"text":"وَتَذَرُونَ ٱلْـَٔاخِرَةَ","tj":[12,13,4]},{"id":22,"text":"وُجُوهٌ يَوْمَئِذٍ نَّاضِرَةٌ","tj":[6,10,1,17,22,1]},{"id":23,"text":"إِلَىٰ رَبِّهَا نَاظِرَةٌ","tj":[]},{"id":24,"text":"وَوُجُوهٌ يَوْمَئِذٍۭ بَاسِرَةٌ","tj":[8,12,1,19,23,1]},{"id":25,"text":"تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌ","tj":[4,7,1,10,14,1]},{"id":26,"text":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ","tj":[5,7,3,23,24,4,24,25,4]},{"id":27,"text":"وَقِيلَ مَنْ رَاقٍ","tj":[15,16,3,16,17,2]},{"id":28,"text":"وَظَنَّ أَنَّهُ ٱلْفِرَاقُ","tj":[4,7,1,10,13,1,16,17,4,23,24,3,24,25,2]},{"id":29,"text":"وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ","tj":[2,3,4,13,14,4,14,15,4,24,25,4,25,26,4,29,30,3,30,31,2]},{"id":30,"text":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ","tj":[26,27,4,33,34,3,34,35,2]},{"id":31,"text":"فَلَا صَدَّقَ وَلَا صَلَّىٰ","tj":[]},{"id":32,"text":"وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ","tj":[4,5,3,7,11,1]},{"id":33,"text":"ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ","tj":[2,5,1,17,20,3,29,30,3]},{"id":34,"text":"أَوْلَىٰ لَكَ فَأَوْلَىٰ","tj":[]},{"id":35,"text":"ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ","tj":[2,5,1]},{"id":36,"text":"أَيَحْسَبُ ٱلْإِنسَٰنُ أَن يُتْرَكَ سُدًى","tj":[11,12,4,16,19,1,19,20,3,25,29,1]},{"id":37,"text":"أَلَمْ يَكُ نُطْفَةً مِّن مَّنِىٍّ يُمْنَىٰ","tj":[14,16,2,19,24,1,24,29,1,33,37,1]},{"id":38,"text":"ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوَّىٰ","tj":[2,5,1,19,23,1]},{"id":39,"text":"فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","tj":[16,17,4,17,18,4,30,31,4,31,32,4,42,43,4,47,50,1]},{"id":40,"text":"أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحْـِۧىَ ٱلْمَوْتَىٰ","tj":[11,12,3,21,22,3,31,34,3,37,41,1,48,49,4]}]}