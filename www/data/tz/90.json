{"surah":90,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِهَٰذَا ٱلْبَلَدِ","tj":[41,43,3,46,48,2,57,58,3,62,63,4,69,70,2]},{"id":2,"text":"وَأَنتَ حِلٌّۢ بِهَٰذَا ٱلْبَلَدِ","tj":[4,7,1,12,16,1,19,20,3,24,25,4,31,32,2]},{"id":3,"text":"وَوَالِدٍ وَمَا وَلَدَ","tj":[8,12,1,20,21,2]},{"id":4,"text":"لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِى كَبَدٍ","tj":[4,6,2,11,13,2,17,18,4,22,25,1,25,26,3,37,38,2]},{"id":5,"text":"أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌ","tj":[13,18,1,18,22,1,22,24,2,42,43,2]},{"id":6,"text":"يَقُولُ أَهْلَكْتُ مَالًا لُّبَدًا","tj":[23,29,1]},{"id":7,"text":"أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ","tj":[13,18,1,27,29,3,34,35,2]},{"id":8,"text":"أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ","tj":[9,11,2,20,21,3,28,29,3]},{"id":9,"text":"وَلِسَانًا وَشَفَتَيْنِ","tj":[8,13,1,19,20,3]},{"id":10,"text":"وَهَدَيْنَٰهُ ٱلنَّجْدَيْنِ","tj":[10,11,3,14,15,4,15,16,4,16,19,1,19,21,2,23,24,3]},{"id":11,"text":"فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ","tj":[6,7,4,7,9,2,16,17,4]},{"id":12,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ","tj":[4,6,3,9,11,2,14,15,3,22,23,4]},{"id":13,"text":"فَكُّ رَقَبَةٍ","tj":[]},{"id":14,"text":"أَوْ إِطْعَٰمٌ فِى يَوْمٍ ذِى مَسْغَبَةٍ","tj":[7,9,2,11,12,3,13,17,1,24,28,1]},{"id":15,"text":"يَتِيمًا ذَا مَقْرَبَةٍ","tj":[6,11,1,15,17,2]},{"id":16,"text":"أَوْ مِسْكِينًا ذَا مَتْرَبَةٍ","tj":[13,18,1]},{"id":17,"text":"ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ","tj":[2,5,1,17,18,4,35,37,4,49,51,4,54,55,4,55,56,4,59,61,2,75,77,4,80,81,4]},{"id":18,"text":"أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلْمَيْمَنَةِ","tj":[2,4,4,6,8,3,19,20,3,23,24,4]},{"id":19,"text":"وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَٰتِنَا هُمْ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ","tj":[2,3,4,19,21,4,30,31,3,48,49,3,52,53,4]},{"id":20,"text":"عَلَيْهِمْ نَارٌ مُّؤْصَدَةٌۢ","tj":[15,20,1]}]}