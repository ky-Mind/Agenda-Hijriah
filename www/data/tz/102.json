{"surah":102,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلْهَىٰكُمُ ٱلتَّكَاثُرُ","tj":[46,47,3,52,53,4,53,54,4]},{"id":2,"text":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ","tj":[17,18,4]},{"id":3,"text":"كَلَّا سَوْفَ تَعْلَمُونَ","tj":[22,23,3]},{"id":4,"text":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ","tj":[2,5,1,28,29,3]},{"id":5,"text":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ","tj":[31,32,4,38,39,3]},{"id":6,"text":"لَتَرَوُنَّ ٱلْجَحِيمَ","tj":[8,11,1,12,13,4,19,20,3]},{"id":7,"text":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ","tj":[2,5,1,14,17,1,28,29,4,35,36,3]},{"id":8,"text":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ","tj":[2,5,1,17,20,1,37,38,4,38,39,4,39,42,1,44,45,3]}]}