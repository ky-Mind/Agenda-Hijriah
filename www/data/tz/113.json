{"surah":113,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ","tj":[60,61,4,67,68,2]},{"id":2,"text":"مِن شَرِّ مَا خَلَقَ","tj":[2,6,1,18,19,2]},{"id":3,"text":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","tj":[4,8,1,30,31,2]},{"id":4,"text":"وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ","tj":[4,8,1,12,13,4,13,14,4,14,17,1,20,21,3,23,24,3,31,32,4,38,39,2]},{"id":5,"text":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","tj":[4,8,1,30,31,2]}]}