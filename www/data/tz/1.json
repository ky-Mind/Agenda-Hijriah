{"surah":1,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","tj":[7,8,4,15,16,4,16,17,4,24,25,3,28,29,4,29,30,4,35,36,3]},{"id":2,"text":"ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ","tj":[24,25,4,29,30,3,34,35,3]},{"id":3,"text":"ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","tj":[1,2,4,9,10,3,13,14,4,14,15,4,20,21,3]},{"id":4,"text":"مَٰلِكِ يَوْمِ ٱلدِّينِ","tj":[2,3,3,15,16,4,16,17,4,20,21,3]},{"id":5,"text":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ","tj":[37,38,3]},{"id":6,"text":"ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ","tj":[9,10,4,10,11,4,16,17,3,20,21,4,31,32,3]},{"id":7,"text":"صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ","tj":[4,5,3,8,9,4,47,48,4,77,78,4,78,79,4,82,84,3,87,88,3]}]}