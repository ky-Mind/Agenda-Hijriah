{"surah":101,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْقَارِعَةُ","tj":[]},{"id":2,"text":"مَا ٱلْقَارِعَةُ","tj":[4,5,4]},{"id":3,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","tj":[4,6,3,9,11,2,14,15,3,22,23,4]},{"id":4,"text":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","tj":[15,16,4,16,17,4,17,20,1,26,27,4,37,38,4,42,44,2,46,47,3]},{"id":5,"text":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","tj":[10,11,4,23,24,4,33,34,4,38,41,1,41,42,3]},{"id":6,"text":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","tj":[4,7,1,11,15,1,26,27,3]},{"id":7,"text":"فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ","tj":[17,22,1]},{"id":8,"text":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","tj":[4,7,1,26,27,3]},{"id":9,"text":"فَأُمُّهُۥ هَاوِيَةٌ","tj":[4,7,1,9,10,3]},{"id":10,"text":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","tj":[4,6,3,9,11,2,14,15,3]},{"id":11,"text":"نَارٌ حَامِيَةٌۢ","tj":[]}]}