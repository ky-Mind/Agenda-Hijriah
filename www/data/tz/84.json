{"surah":84,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ","tj":[45,46,4,46,47,4,52,54,3,57,58,4,58,61,1]},{"id":2,"text":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","tj":[]},{"id":3,"text":"وَإِذَا ٱلْأَرْضُ مُدَّتْ","tj":[8,9,4]},{"id":4,"text":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ","tj":[]},{"id":5,"text":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","tj":[]},{"id":6,"text":"يَٰٓأَيُّهَا ٱلْإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَٰقِيهِ","tj":[2,4,3,13,14,4,18,21,1,21,22,3,27,30,1,58,60,2,61,66,1,70,71,3,73,74,3]},{"id":7,"text":"فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ","tj":[4,7,1,26,27,3,31,32,3]},{"id":8,"text":"فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا","tj":[25,30,1]},{"id":9,"text":"وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًا","tj":[4,7,1,16,19,3,28,29,3]},{"id":10,"text":"وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ","tj":[4,7,1,26,27,3,31,32,3,37,39,3]},{"id":11,"text":"فَسَوْفَ يَدْعُوا۟ ثُبُورًا","tj":[11,13,2,16,18,4]},{"id":12,"text":"وَيَصْلَىٰ سَعِيرًا","tj":[]},{"id":13,"text":"إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا","tj":[2,5,1,7,8,3,17,19,3,28,29,3]},{"id":14,"text":"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ","tj":[2,5,1,7,8,3,11,14,1,17,22,1,22,26,1,28,29,3]},{"id":15,"text":"بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًا","tj":[4,7,3,10,13,1,21,22,3,33,34,3]},{"id":16,"text":"فَلَآ أُقْسِمُ بِٱلشَّفَقِ","tj":[4,6,3,9,11,2,18,19,4,19,20,4,25,26,2]},{"id":17,"text":"وَٱلَّيْلِ وَمَا وَسَقَ","tj":[2,3,4,21,22,2]},{"id":18,"text":"وَٱلْقَمَرِ إِذَا ٱتَّسَقَ","tj":[2,3,4,18,19,4,24,25,2]},{"id":19,"text":"لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍ","tj":[10,13,1,24,28,1,30,31,2]},{"id":20,"text":"فَمَا لَهُمْ لَا يُؤْمِنُونَ","tj":[25,26,3]},{"id":21,"text":"وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ","tj":[26,27,4,51,52,3]},{"id":22,"text":"بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ","tj":[5,6,4,22,24,4,34,35,3]},{"id":23,"text":"وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ","tj":[2,3,4,30,31,3]},{"id":24,"text":"فَبَشِّرْهُم بِعَذ