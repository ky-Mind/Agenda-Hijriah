{"surah":85,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ ذَاتِ ٱلْبُرُوجِ","tj":[41,42,4,42,43,4,48,50,3,59,60,4,66,67,3,67,68,2]},{"id":2,"text":"وَٱلْيَوْمِ ٱلْمَوْعُودِ","tj":[2,3,4,12,13,4,21,22,3,22,23,2]},{"id":3,"text":"وَشَاهِدٍ وَمَشْهُودٍ","tj":[8,12,1,18,19,3,19,20,2]},{"id":4,"text":"قُتِلَ أَصْحَٰبُ ٱلْأُخْدُودِ","tj":[13,14,3,17,18,4,26,27,3,27,28,2]},{"id":5,"text":"ٱلنَّارِ ذَاتِ ٱلْوَقُودِ","tj":[1,2,4,2,5,1,15,16,4,22,23,3,23,24,2]},{"id":6,"text":"إِذْ هُمْ عَلَيْهَا قُعُودٌ","tj":[24,25,3,25,26,2]},{"id":7,"text":"وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِٱلْمُؤْمِنِينَ شُهُودٌ","tj":[32,33,4,51,52,3,52,53,2]},{"id":8,"text":"وَمَا نَقَمُوا۟ مِنْهُمْ إِلَّآ أَن يُؤْمِنُوا۟ بِٱللَّهِ ٱلْعَزِيزِ ٱلْحَمِيدِ","tj":[13,15,4,30,32,3,35,39,1,46,48,4,51,52,4,59,60,4,70,71,4,77,78,3,78,79,2]},{"id":9,"text":"ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ شَهِيدٌ","tj":[12,13,3,21,22,4,22,23,4,28,29,3,31,32,3,37,38,4,49,50,4,75,79,1,81,82,3,82,83,2]},{"id":10,"text":"إِنَّ ٱلَّذِينَ فَتَنُوا۟ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَٰتِ ثُمَّ لَمْ يَتُوبُوا۟ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ ٱلْحَرِيقِ","tj":[2,5,1,6,7,4,23,25,4,26,27,4,43,44,4,54,55,3,60,63,1,77,79,4,101,104,1,124,125,4,131,132,3,132,133,2]},{"id":11,"text":"إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ جَنَّٰتٌ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ ذَٰلِكَ ٱلْفَوْزُ ٱلْكَبِيرُ","tj":[2,5,1,6,7,4,24,26,4,36,38,4,39,40,4,40,41,4,44,45,3,49,50,3,62,65,1,65,66,3,67,71,1,71,73,2,79,83,1,91,92,4,100,101,3,106,107,3,112,113,4,122,123,4,129,130,3]},{"id":12,"text":"إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌ","tj":[2,5,1,8,10,2,27,28,3,28,29,2]},{"id":13,"text":"إِنَّهُۥ هُوَ يُبْدِئُ وَيُعِيدُ","tj":[2,5,1,7,8,3,16,18,2,29,30,3,30,31,2]},{"id":14,"text":"وَهُوَ ٱلْغَفُورُ ٱلْوَدُودُ","tj":[7,8,4,18,19,4,25,26,3,26,27,2]},{"id":15,"text":"ذُو ٱلْعَرْشِ ٱلْمَجِيدُ","tj":[4,5,4,14,15,4,21,22,3,22,23,2]},{"id":16,"text":"فَعَّالٌ لِّمَا يُرِيدُ","tj":[7,12,1,20,21,3,21,22,2]},{"id":17,"text":"هَلْ أَتَىٰكَ حَدِيثُ ٱلْجُنُودِ","tj":[10,11,3,22,23,4,29,30,3,30,31,2]},{"id":18,"text":"فِرْعَوْنَ وَثَمُودَ","tj":[17,18,3,18,19,2]},{"id":19,"text":"بَلِ ٱلَّذِينَ كَفَرُوا۟ فِى تَكْذِيبٍ","tj":[5,6,4,22,24,4,35,36,3,36,37,2]},{"id":20,"text":"وَٱللَّهُ مِن وَرَآئِهِم مُّحِيطٌۢ","tj":[2,3,4,12,16,1,18,20,3,24,29,1,31,32,3,32,33,2]},{"id":21,"text":"بَلْ هُوَ قُرْءَانٌ مَّجِيدٌ","tj":[18,23,1,25,26,3,26,27,2]},{"id":22,"text":"فِى لَوْحٍ مَّحْفُوظٍۭ","tj":[9,14,1,18,19,3]}]}