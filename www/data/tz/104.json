{"surah":104,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ","tj":[44,49,1,62,67,1]},{"id":2,"text":"ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ","tj":[19,24,1]},{"id":3,"text":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","tj":[11,14,1,22,24,3]},{"id":4,"text":"كَلَّا لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ","tj":[12,14,1,17,20,1,25,26,4]},{"id":5,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","tj":[4,6,3,9,11,2,14,15,3,22,23,4]},{"id":6,"text":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","tj":[6,7,4,14,15,4]},{"id":7,"text":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ","tj":[24,25,4]},{"id":8,"text":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ","tj":[2,5,1,17,22,1]},{"id":9,"text":"فِى عَمَدٍ مُّمَدَّدَةٍۭ","tj":[9,14,1]}]}