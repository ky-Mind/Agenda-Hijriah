{"surah":105,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ ٱلْفِيلِ","tj":[81,82,3,85,86,4,90,91,3]},{"id":2,"text":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍ","tj":[9,11,2,37,38,3]},{"id":3,"text":"وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ","tj":[37,38,3]},{"id":4,"text":"تَرْمِيهِم بِحِجَارَةٍ مِّن سِجِّيلٍ","tj":[9,13,1,21,26,1,26,30,1,33,34,3]},{"id":5,"text":"فَجَعَلَهُمْ كَعَصْفٍ مَّأْكُولٍۭ","tj":[20,25,1,29,30,3]}]}