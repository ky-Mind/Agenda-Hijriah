{"surah":82,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ","tj":[45,46,4,46,47,4,52,54,3,57,58,4,58,61,1]},{"id":2,"text":"وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ","tj":[8,9,4,21,22,4,22,25,1]},{"id":3,"text":"وَإِذَا ٱلْبِحَارُ فُجِّرَتْ","tj":[8,9,4]},{"id":4,"text":"وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ","tj":[8,9,4]},{"id":5,"text":"عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَأَخَّرَتْ","tj":[14,19,1]},{"id":6,"text":"يَٰٓأَيُّهَا ٱلْإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ","tj":[2,4,3,13,14,4,18,21,1,21,22,3,47,48,4,54,55,3]},{"id":7,"text":"ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ","tj":[25,26,3]},{"id":8,"text":"فِىٓ أَىِّ صُورَةٍ مَّا شَآءَ رَكَّبَكَ","tj":[2,4,3,17,22,1,26,28,3]},{"id":9,"text":"كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ","tj":[27,28,4,28,29,4,32,33,3]},{"id":10,"text":"وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ","tj":[4,7,1,23,24,3,28,29,3]},{"id":11,"text":"كِرَامًا كَٰتِبِينَ","tj":[6,11,1,11,12,3,16,17,3]},{"id":12,"text":"يَعْلَمُونَ مَا تَفْعَلُونَ","tj":[24,25,3]},{"id":13,"text":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ","tj":[2,5,1,6,7,4,11,13,2,29,30,3]},{"id":14,"text":"وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍ","tj":[4,7,1,8,9,4,30,31,3]},{"id":15,"text":"يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ","tj":[21,22,4,22,23,4,26,27,3]},{"id":16,"text":"وَمَا هُمْ عَنْهَا بِغَآئِبِينَ","tj":[23,25,3,29,30,3]},{"id":17,"text":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","tj":[4,6,3,9,11,2,14,15,3,29,30,4,30,31,4,34,35,3]},{"id":18,"text":"ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","tj":[2,5,1,8,10,3,13,15,2,18,19,3,33,34,4,34,35,4,38,39,3]},{"id":19,"text":"يَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَيْـًٔا وَٱلْأَمْرُ يَوْمَئِذٍ لِّلَّهِ","tj":[25,30,1,35,39,1,43,48,1,48,49,4,67,72,1]}]}