{"surah":109,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ","tj":[46,48,3,57,58,4,62,63,3,67,68,3]},{"id":2,"text":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","tj":[2,4,3,26,27,3]},{"id":3,"text":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","tj":[4,6,3,9,12,1,17,18,3,28,30,3,37,38,2]},{"id":4,"text":"وَلَآ أَنَا۠ عَابِدٌ مَّا عَبَدتُّمْ","tj":[4,6,3,20,25,1,31,32,1]},{"id":5,"text":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","tj":[4,6,3,9,12,1,17,18,3,28,30,3,37,38,2]},{"id":6,"text":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","tj":[26,27,3]}]}