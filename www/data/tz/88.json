{"surah":88,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ","tj":[49,50,3,61,62,4,66,67,3]},{"id":2,"text":"وُجُوهٌ يَوْمَئِذٍ خَٰشِعَةٌ","tj":[6,10,1,21,22,3]},{"id":3,"text":"عَامِلَةٌ نَّاصِبَةٌ","tj":[8,13,1]},{"id":4,"text":"تَصْلَىٰ نَارًا حَامِيَةً","tj":[]},{"id":5,"text":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ","tj":[]},{"id":6,"text":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ","tj":[32,36,1,38,39,3]},{"id":7,"text":"لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ","tj":[30,34,1,34,35,3]},{"id":8,"text":"وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ","tj":[6,10,1,17,22,1]},{"id":9,"text":"لِّسَعْيِهَا رَاضِيَةٌ","tj":[]},{"id":10,"text":"فِى جَنَّةٍ عَالِيَةٍ","tj":[6,9,1]},{"id":11,"text":"لَّا تَسْمَعُ فِيهَا لَٰغِيَةً","tj":[23,24,3]},{"id":12,"text":"فِيهَا عَيْنٌ جَارِيَةٌ","tj":[12,16,1]},{"id":13,"text":"فِيهَا سُرُرٌ مَّرْفُوعَةٌ","tj":[12,17,1]},{"id":14,"text":"وَأَكْوَابٌ مَّوْضُوعَةٌ","tj":[10,15,1]},{"id":15,"text":"وَنَمَارِقُ مَصْفُوفَةٌ","tj":[]},{"id":16,"text":"وَزَرَابِىُّ مَبْثُوثَةٌ","tj":[15,17,2]},{"id":17,"text":"أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ","tj":[10,13,1,25,26,4]},{"id":18,"text":"وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ","tj":[8,9,4,9,10,4,15,17,3]},{"id":19,"text":"وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ","tj":[8,9,4]},{"id":20,"text":"وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ","tj":[8,9,4]},{"id":21,"text":"فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ","tj":[12,15,1,17,19,3,22,25,1]},{"id":22,"text":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ","tj":[16,20,1]},{"id":23,"text":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","tj":[9,13,1]},{"id":24,"text":"فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ","tj":[14,15,4,22,23,4,33,34,4]},{"id":25,"text":"إِنَّ إِلَيْنَآ إِيَابَهُمْ","tj":[2,5,1,14,16,3]},{"id":26,"text":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم","tj":[2,5,1,8,11,1]}]}