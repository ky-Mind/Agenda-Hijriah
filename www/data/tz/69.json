{"surah":69,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْحَآقَّةُ","tj":[44,46,3]},{"id":2,"text":"مَا ٱلْحَآقَّةُ","tj":[4,5,4,9,11,3]},{"id":3,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْحَآقَّةُ","tj":[4,6,3,9,11,2,14,15,3,22,23,4,27,29,3]},{"id":4,"text":"كَذَّبَتْ ثَمُودُ وَعَادٌۢ بِٱلْقَارِعَةِ","tj":[24,28,1,29,30,4]},{"id":5,"text":"فَأَمَّا ثَمُودُ فَأُهْلِكُوا۟ بِٱلطَّاغِيَةِ","tj":[4,7,1,28,30,4,33,34,4,34,35,4]},{"id":6,"text":"وَأَمَّا عَادٌ فَأُهْلِكُوا۟ بِرِيحٍ صَرْصَرٍ عَاتِيَةٍ","tj":[4,7,1,13,17,1,26,28,4,35,39,1]},{"id":7,"text":"سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٍ وَثَمَٰنِيَةَ أَيَّامٍ حُسُومًا فَتَرَى ٱلْقَوْمَ فِيهَا صَرْعَىٰ كَأَنَّهُمْ أَعْجَازُ نَخْلٍ خَاوِيَةٍ","tj":[24,26,2,35,39,1,43,44,3,66,71,1,77,78,4,107,110,1]},{"id":8,"text":"فَهَلْ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٍ","tj":[18,23,1,24,27,1]},{"id":9,"text":"وَجَآءَ فِرْعَوْنُ وَمَن قَبْلَهُۥ وَٱلْمُؤْتَفِكَٰتُ بِٱلْخَاطِئَةِ","tj":[4,6,3,24,28,1,28,30,2,34,35,3,38,39,4,51,52,3,57,58,4]},{"id":10,"text":"فَعَصَوْا۟ رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَةً رَّابِيَةً","tj":[8,10,4,49,54,1]},{"id":11,"text":"إِنَّا لَمَّا طَغَا ٱلْمَآءُ حَمَلْنَٰكُمْ فِى ٱلْجَارِيَةِ","tj":[2,5,1,9,12,1,20,21,4,25,27,3,38,39,3,48,49,4]},{"id":12,"text":"لِنَجْعَلَهَا لَكُمْ تَذْكِرَةً وَتَعِيَهَآ أُذُنٌ وَٰعِيَةٌ","tj":[4,6,2,30,34,1,42,44,3,50,54,1,54,55,3]},{"id":13,"text":"فَإِذَا نُفِخَ فِى ٱلصُّورِ نَفْخَةٌ وَٰحِدَةٌ","tj":[19,20,4,20,21,4,35,39,1,39,40,3]},{"id":14,"text":"وَحُمِلَتِ ٱلْأَرْضُ وَٱلْجِبَالُ فَدُكَّتَا دَكَّةً وَٰحِدَةً","tj":[11,12,4,23,24,4,51,55,1,55,56,3]},{"id":15,"text":"فَيَوْمَئِذٍ وَقَعَتِ ٱلْوَاقِعَةُ","tj":[11,15,1,22,23,4]},{"id":16,"text":"وَٱنشَقَّتِ ٱلسَّمَآءُ فَهِىَ يَوْمَئِذٍ وَاهِيَةٌ","tj":[2,3,4,3,6,1,12,13,4,13,14,4,19,21,3,40,44,1]},{"id":17,"text":"وَٱلْمَلَكُ عَلَىٰٓ أَرْجَآئِهَا وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٍ ثَمَٰنِيَةٌ","tj":[2,3,4,16,19,3,26,28,3,80,84,1,86,87,3]},{"id":18,"text":"يَوْمَئِذٍ تُعْرَضُونَ لَا تَخْفَىٰ مِنكُمْ خَافِيَةٌ","tj":[9,13,1,38,41,1]},{"id":19,"text":"فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ ٱقْرَءُوا۟ كِتَٰبِيَهْ","tj":[4,7,1,26,27,3,31,32,3,44,45,3,58,60,3,65,66,4,66,68,2,73,75,4,80,81,3]},{"id":20,"text":"إِنِّى ظَنَنتُ أَنِّى مُلَٰقٍ حِسَابِيَهْ","tj":[2,5,1,11,14,1,17,20,1,26,27,3]},{"id":21,"text":"فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ","tj":[17,22,1]},{"id":22,"text":"فِى جَنَّةٍ عَالِيَةٍ","tj":[6,9,1]},{"id":23,"text":"قُطُوفُهَا دَانِيَةٌ","tj":[]},{"id":24,"text":"كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَآ أَسْلَفْتُمْ فِى ٱلْأَيَّامِ ٱلْخَالِيَةِ","tj":[5,7,4,10,11,4,18,20,4,25,27,3,29,34,1,37,39,3,57,58,4,69,70,4]},{"id":25,"text":"وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِشِمَالِهِۦ فَيَقُولُ يَٰلَيْتَنِى لَمْ أُوتَ كِتَٰبِيَهْ","tj":[4,7,1,26,27,3,31,32,3,44,45,3,58,59,3,84,85,3]},{"id":26,"text":"وَلَمْ أَدْرِ مَا حِسَابِيَهْ","tj":[9,11,2]},{"id":27,"text":"يَٰلَيْتَهَا كَانَتِ ٱلْقَاضِيَةَ","tj":[2,3,3,21,22,4]},{"id":28,"text":"مَآ أَغْنَىٰ عَنِّى مَالِيَهْ","tj":[2,4,3,16,19,1]},{"id":29,"text":"هَلَكَ عَنِّى سُلْطَٰنِيَهْ","tj":[9,12,1,20,21,3]},{"id":30,"text":"خُذُوهُ فَغُلُّوهُ","tj":[15,16,3]},{"id":31,"text":"ثُمَّ ٱلْجَحِيمَ صَلُّوهُ","tj":[2,5,1,6,7,4,22,23,3]},{"id":32,"text":"ثُمَّ فِى سِلْسِلَةٍ ذَرْعُهَا سَبْعُونَ ذِرَاعًا فَٱسْلُكُوهُ","tj":[2,5,1,19,23,1,33,35,2,47,52,1,52,53,4,59,60,3]},{"id":33,"text":"إِنَّهُۥ كَانَ لَا يُؤْمِنُ بِٱللَّهِ ٱلْعَظِيمِ","tj":[2,5,1,7,8,3,30,31,4,38,39,4,45,46,3]},{"id":34,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","tj":[29,30,4,38,39,3]},{"id":35,"text":"فَلَيْسَ لَهُ ٱلْيَوْمَ هَٰهُنَا حَمِيمٌ","tj":[14,15,4,26,27,3,37,38,3]},{"id":36,"text":"وَلَا طَعَامٌ إِلَّا مِنْ غِسْلِينٍ","tj":[32,33,3]},{"id":37,"text":"لَّا يَأْكُلُهُۥٓ إِلَّا ٱلْخَٰطِـُٔونَ","tj":[15,17,3,25,26,4,30,31,3,36,37,3]},{"id":38,"text":"فَلَآ أُقْسِمُ بِمَا تُبْصِرُونَ","tj":[4,6,3,9,11,2,24,26,2,30,31,3]},{"id":39,"text":"وَمَا لَا تُبْصِرُونَ","tj":[12,14,2,18,19,3]},{"id":40,"text":"إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ","tj":[2,5,1,7,8,3,24,28,1,30,31,3]},{"id":41,"text":"وَمَا هُوَ بِقَوْلِ شَاعِرٍ قَلِيلًا مَّا تُؤْمِنُونَ","tj":[26,30,1,34,40,1,50,51,3]},{"id":42,"text":"وَلَا بِقَوْلِ كَاهِنٍ قَلِيلًا مَّا تَذَكَّرُونَ","tj":[21,25,1,29,35,1,46,47,3]},{"id":43,"text":"تَنزِيلٌ مِّن رَّبِّ ٱلْعَٰلَمِينَ","tj":[2,5,1,7,12,1,12,17,1,21,22,4,26,27,3,31,32,3]},{"id":44,"text":"وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ ٱلْأَقَاوِيلِ","tj":[34,35,4,44,45,3]},{"id":45,"text":"لَأَخَذْنَا مِنْهُ بِٱلْيَمِينِ","tj":[21,22,4,28,29,3]},{"id":46,"text":"ثُمَّ لَقَطَعْنَا مِنْهُ ٱلْوَتِينَ","tj":[2,5,1,25,26,4,32,33,3]},{"id":47,"text":"فَمَا مِنكُم مِّنْ أَحَدٍ عَنْهُ حَٰجِزِينَ","tj":[8,11,1,11,16,1,35,36,3,40,41,3]},{"id":48,"text":"وَإِنَّهُۥ لَتَذْكِرَةٌ لِّلْمُتَّقِينَ","tj":[4,7,1,9,10,3,22,27,1,36,37,3]},{"id":49,"text":"وَإِنَّا لَنَعْلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ","tj":[4,7,1,22,25,1,28,31,1,31,36,1,43,44,3]},{"id":50,"text":"وَإِنَّهُۥ لَحَسْرَةٌ عَلَى ٱلْكَٰفِرِينَ","tj":[4,7,1,9,10,3,28,29,4,33,34,3,38,39,3]},{"id":51,"text":"وَإِنَّهُۥ لَحَقُّ ٱلْيَقِينِ","tj":[4,7,1,9,10,3,19,20,4,26,27,3]},{"id":52,"text":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ","tj":[12,13,4,26,27,4,33,34,3]}]}