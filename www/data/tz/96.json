{"surah":96,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","tj":[40,42,2,49,50,4,63,64,4,75,76,2]},{"id":2,"text":"خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ","tj":[7,8,4,12,15,1,15,16,3,28,29,2]},{"id":3,"text":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","tj":[1,3,2,18,19,4]},{"id":4,"text":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","tj":[18,19,4]},{"id":5,"text":"عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ","tj":[8,9,4,13,16,1,16,17,3]},{"id":6,"text":"كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ","tj":[5,7,3,10,13,1,14,15,4,19,22,1,22,23,3,30,32,2]},{"id":7,"text":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","tj":[2,7,1,13,14,4]},{"id":8,"text":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","tj":[2,5,1,21,22,4,22,23,4,26,28,2]},{"id":9,"text":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","tj":[11,12,4]},{"id":10,"text":"عَبْدًا إِذَا صَلَّىٰٓ","tj":[2,4,2]},{"id":11,"text":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","tj":[13,17,1,27,28,4]},{"id":12,"text":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","tj":[14,15,4,15,16,4,19,21,2]},{"id":13,"text":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","tj":[13,17,1]},{"id":14,"text":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","tj":[13,17,1,19,22,1,23,24,4]},{"id":15,"text":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","tj":[11,16,1,21,24,1,36,41,1,42,43,4,43,44,4,44,47,1]},{"id":16,"text":"نَاصِيَةٍ كَٰذِبَةٍ خَاطِئَةٍ","tj":[8,12,1,12,13,3]},{"id":17,"text":"فَلْيَدْعُ نَادِيَهُۥ","tj":[6,8,2]},{"id":18,"text":"سَنَدْعُ ٱلزَّبَانِيَةَ","tj":[4,6,2,9,10,4,10,11,4]},{"id":19,"text":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب","tj":[22,23,4,27,29,2,32,33,4,33,35,2,39,40,2]}]}