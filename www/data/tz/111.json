{"surah":111,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ تَبَّتْ يَدَآ أَبِى لَهَبٍ وَتَبَّ","tj":[51,53,3,65,69,1,71,72,2]},{"id":2,"text":"مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ","tj":[2,4,3,28,29,3,40,41,2]},{"id":3,"text":"سَيَصْلَىٰ نَارًا ذَاتَ لَهَبٍ","tj":[15,20,1,28,29,2]},{"id":4,"text":"وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ","tj":[2,3,4,13,14,3,17,20,1,26,27,4,33,34,2]},{"id":5,"text":"فِى جِيدِهَا حَبْلٌ مِّن مَّسَدٍۭ","tj":[15,17,2,18,23,1,23,28,1,30,31,2]}]}