{"surah":80,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَبَسَ وَتَوَلَّىٰٓ","tj":[]},{"id":2,"text":"أَن جَآءَهُ ٱلْأَعْمَىٰ","tj":[2,6,1,6,8,3,13,14,4]},{"id":3,"text":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","tj":[8,10,2,25,26,3]},{"id":4,"text":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ","tj":[20,23,1,28,29,4,29,30,4]},{"id":5,"text":"أَمَّا مَنِ ٱسْتَغْنَىٰ","tj":[2,5,1,12,13,4]},{"id":6,"text":"فَأَنتَ لَهُۥ تَصَدَّىٰ","tj":[4,7,1,12,13,3]},{"id":7,"text":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ","tj":[]},{"id":8,"text":"وَأَمَّا مَن جَآءَكَ يَسْعَىٰ","tj":[4,7,1,11,15,1,15,17,3]},{"id":9,"text":"وَهُوَ يَخْشَىٰ","tj":[]},{"id":10,"text":"فَأَنتَ عَنْهُ تَلَهَّىٰ","tj":[4,7,1]},{"id":11,"text":"كَلَّآ إِنَّهَا تَذْكِرَةٌ","tj":[5,7,3,10,13,1]},{"id":12,"text":"فَمَن شَآءَ ذَكَرَهُۥ","tj":[4,8,1,8,10,3]},{"id":13,"text":"فِى صُحُفٍ مُّكَرَّمَةٍ","tj":[9,14,1]},{"id":14,"text":"مَّرْفُوعَةٍ مُّطَهَّرَةٍۭ","tj":[11,16,1]},{"id":15,"text":"بِأَيْدِى سَفَرَةٍ","tj":[]},{"id":16,"text":"كِرَامٍۭ بَرَرَةٍ","tj":[6,10,1]},{"id":17,"text":"قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ","tj":[7,8,4,12,15,1,15,16,3,21,23,3]},{"id":18,"text":"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ","tj":[]},{"id":19,"text":"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","tj":[2,7,1,7,9,2,22,23,3]},{"id":20,"text":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","tj":[2,5,1,6,7,4,7,8,4]},{"id":21,"text":"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ","tj":[2,5,1,15,16,3,21,23,2]},{"id":22,"text":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ","tj":[2,5,1,14,16,3,21,24,1]},{"id":23,"text":"كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ","tj":[9,12,1,16,18,2,23,25,3]},{"id":24,"text":"فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ","tj":[6,9,1,12,13,4,17,20,1,20,21,3]},{"id":25,"text":"أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا","tj":[2,5,1,11,13,2,17,18,4,22,24,3]},{"id":26,"text":"ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا","tj":[2,5,1,10,12,2,16,17,4]},{"id":27,"text":"فَأَنۢبَتْنَا فِيهَا حَبًّا","tj":[5,7,1]},{"id":28,"text":"وَعِنَبًا وَقَضْبًا","tj":[7,12,1]},{"id":29,"text":"وَزَيْتُونًا وَنَخْلًا","tj":[10,15,1]},{"id":30,"text":"وَحَدَآئِقَ غُلْبًا","tj":[6,8,3]},{"id":31,"text":"وَفَٰكِهَةً وَأَبًّا","tj":[4,5,3,10,14,1]},{"id":32,"text":"مَّتَٰعًا لَّكُمْ وَلِأَنْعَٰمِكُمْ","tj":[5,6,3,7,13,1,28,29,3]},{"id":33,"text":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ","tj":[10,12,3,17,18,4,18,19,4,22,24,3]},{"id":34,"text":"يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ","tj":[15,16,4,34,35,3]},{"id":35,"text":"وَأُمِّهِۦ وَأَبِيهِ","tj":[4,7,1,9,10,3,17,18,3]},{"id":36,"text":"وَصَٰحِبَتِهِۦ وَبَنِيهِ","tj":[4,5,3,13,14,3,21,22,3]},{"id":37,"text":"لِكُلِّ ٱمْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ","tj":[8,9,4,14,19,1,35,39,1,42,46,1,50,51,3]},{"id":38,"text":"وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ","tj":[6,10,1,17,22,1]},{"id":39,"text":"ضَاحِكَةٌ مُّسْتَبْشِرَةٌ","tj":[8,13,1,17,19,2]},{"id":40,"text":"وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ","tj":[8,12,1]},{"id":41,"text":"تَرْهَقُهَا قَتَرَةٌ","tj":[]},{"id":42,"text":"أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ","tj":[2,4,4,6,8,3,18,19,4,30,31,4]}]}