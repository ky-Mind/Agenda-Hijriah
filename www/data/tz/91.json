{"surah":91,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلشَّمْسِ وَضُحَىٰهَا","tj":[41,42,4,42,43,4,58,59,3]},{"id":2,"text":"وَٱلْقَمَرِ إِذَا تَلَىٰهَا","tj":[2,3,4,23,24,3]},{"id":3,"text":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا","tj":[2,3,4,3,4,4,4,7,1,25,26,3]},{"id":4,"text":"وَٱلَّيْلِ إِذَا يَغْشَىٰهَا","tj":[2,3,4,24,25,3]},{"id":5,"text":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا","tj":[2,3,4,3,4,4,9,11,3,25,26,3]},{"id":6,"text":"وَٱلْأَرْضِ وَمَا طَحَىٰهَا","tj":[2,3,4,23,24,3]},{"id":7,"text":"وَنَفْسٍ وَمَا سَوَّىٰهَا","tj":[7,11,1,21,22,3]},{"id":8,"text":"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا","tj":[29,31,2,34,35,3]},{"id":9,"text":"قَدْ أَفْلَحَ مَن زَكَّىٰهَا","tj":[2,4,2,16,20,1,24,25,3]},{"id":10,"text":"وَقَدْ خَابَ مَن دَسَّىٰهَا","tj":[4,6,2,15,19,1,23,24,3]},{"id":11,"text":"كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ","tj":[27,28,3]},{"id":12,"text":"إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا","tj":[5,6,4,7,9,1,22,23,3]},{"id":13,"text":"فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَٰهَا","tj":[23,24,4,39,40,4,51,53,2,55,56,3]},{"id":14,"text":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا","tj":[55,59,1,62,64,1,78,79,3]},{"id":15,"text":"وَلَا يَخَافُ عُقْبَٰهَا","tj":[16,18,2,20,21,3]}]}