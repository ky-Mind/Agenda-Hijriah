{"surah":78,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَمَّ يَتَسَآءَلُونَ","tj":[41,44,1,51,53,3,57,58,3]},{"id":2,"text":"عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ","tj":[5,6,4,6,7,4,7,10,1,15,16,4,22,23,3]},{"id":3,"text":"ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ","tj":[29,30,3]},{"id":4,"text":"كَلَّا سَيَعْلَمُونَ","tj":[17,18,3]},{"id":5,"text":"ثُمَّ كَلَّا سَيَعْلَمُونَ","tj":[2,5,1,23,24,3]},{"id":6,"text":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَٰدًا","tj":[9,11,2,16,17,4,30,31,3]},{"id":7,"text":"وَٱلْجِبَالَ أَوْتَادًا","tj":[2,3,4]},{"id":8,"text":"وَخَلَقْنَٰكُمْ أَزْوَٰجًا","tj":[6,8,2,10,11,3,22,23,3]},{"id":9,"text":"وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا","tj":[]},{"id":10,"text":"وَجَعَلْنَا ٱلَّيْلَ لِبَاسًا","tj":[12,13,4]},{"id":11,"text":"وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًا","tj":[12,13,4,13,14,4,14,17,1]},{"id":12,"text":"وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا","tj":[25,27,2,28,33,1]},{"id":13,"text":"وَجَعَلْنَا سِرَاجًا وَهَّاجًا","tj":[18,23,1]},{"id":14,"text":"وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءً ثَجَّاجًا","tj":[4,7,1,18,19,4,29,30,3,35,37,3,38,42,1]},{"id":15,"text":"لِّنُخْرِجَ بِهِۦ حَبًّا وَنَبَاتًا","tj":[16,17,3,22,27,1]},{"id":16,"text":"وَجَنَّٰتٍ أَلْفَافًا","tj":[4,7,1,7,8,3]},{"id":17,"text":"إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَٰتًا","tj":[2,5,1,13,14,4,34,35,3]},{"id":18,"text":"يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًا","tj":[9,12,1,19,20,4,20,21,4]},{"id":19,"text":"وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًا","tj":[11,12,4,12,13,4,18,20,3,35,37,2,39,40,3]},{"id":20,"text":"وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا","tj":[12,13,4]},{"id":21,"text":"إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا","tj":[2,5,1,10,13,1]},{"id":22,"text":"لِّلطَّٰغِينَ مَـَٔابًا","tj":[3,4,4,7,8,3]},{"id":23,"text":"لَّٰبِثِينَ فِيهَآ أَحْقَابًا","tj":[3,4,3,17,19,3]},{"id":24,"text":"لَّا يَذُوقُونَ فِيهَا بَرْدًا وَلَا شَرَابًا","tj":[28,33,1]},{"id":25,"text":"إِلَّا حَمِيمًا وَغَسَّاقًا","tj":[13,18,1]},{"id":26,"text":"جَزَآءً وِفَاقًا","tj":[4,6,3,7,11,1]},{"id":27,"text":"إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًا","tj":[2,5,1,16,18,4]},{"id":28,"text":"وَكَذَّبُوا۟ بِـَٔايَٰتِنَا كِذَّابًا","tj":[10,12,4,21,22,3]},{"id":29,"text":"وَكُلَّ شَىْءٍ أَحْصَيْنَٰهُ كِتَٰبًا","tj":[25,26,3,33,34,3]},{"id":30,"text":"فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا","tj":[8,10,4,15,20,1]},{"id":31,"text":"إِنَّ لِلْمُتَّقِينَ مَفَازًا","tj":[2,5,1]},{"id":32,"text":"حَدَآئِقَ وَأَعْنَٰبًا","tj":[4,6,3,19,20,3]},{"id":33,"text":"وَكَوَاعِبَ أَتْرَابًا","tj":[]},{"id":34,"text":"وَكَأْسًا دِهَاقًا","tj":[7,12,1]},{"id":35,"text":"لَّا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا كِذَّٰبًا","tj":[29,34,1,43,44,3]},{"id":36,"text":"جَزَآءً مِّن رَّبِّكَ عَطَآءً حِسَابًا","tj":[4,6,3,7,12,1,12,17,1,27,29,3]},{"id":37,"text":"رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَٰنِ لَا يَمْلِكُونَ مِنْهُ خِطَابًا","tj":[7,8,4,8,9,4,14,15,3,17,18,3,23,24,4,51,52,4,52,53,4,60,61,3]},{"id":38,"text":"يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَٰٓئِكَةُ صَفًّا لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَٰنُ وَقَالَ صَوَابًا","tj":[15,16,4,16,17,4,26,27,4,33,35,3,46,52,1,93,94,4,94,95,4,102,103,3]},{"id":39,"text":"ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا","tj":[2,3,3,8,9,4,18,19,4,31,35,1,35,37,3,40,41,4,63,64,3]},{"id":40,"text":"إِنَّآ أَنذَرْنَٰكُمْ عَذَابًا قَرِيبًا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَٰلَيْتَنِى كُنتُ تُرَٰبًۢا","tj":[2,5,1,5,7,3,10,13,1,17,18,3,29,34,1,38,43,1,50,53,1,56,57,4,98,99,4,111,112,3,124,127,1,132,133,3]}]}