{"surah":81,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ","tj":[45,46,4,46,47,4]},{"id":2,"text":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ","tj":[8,9,4,9,10,4,10,13,1,19,20,4,20,23,1]},{"id":3,"text":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ","tj":[8,9,4]},{"id":4,"text":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ","tj":[8,9,4]},{"id":5,"text":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ","tj":[8,9,4]},{"id":6,"text":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ","tj":[8,9,4]},{"id":7,"text":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ","tj":[8,9,4,9,10,4,10,13,1]},{"id":8,"text":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ","tj":[8,9,4,17,18,3]},{"id":9,"text":"بِأَىِّ ذَنۢبٍ قُتِلَتْ","tj":[11,13,1,13,17,1]},{"id":10,"text":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ","tj":[8,9,4,9,10,4]},{"id":11,"text":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ","tj":[8,9,4,9,10,4,15,17,3]},{"id":12,"text":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ","tj":[8,9,4]},{"id":13,"text":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ","tj":[8,9,4,13,16,1]},{"id":14,"text":"عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ","tj":[14,19,1,19,21,3]},{"id":15,"text":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ","tj":[4,6,3,9,11,2,18,19,4,23,26,1]},{"id":16,"text":"ٱلْجَوَارِ ٱلْكُنَّسِ","tj":[11,12,4,16,19,1]},{"id":17,"text":"وَٱلَّيْلِ إِذَا عَسْعَسَ","tj":[2,3,4]},{"id":18,"text":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ","tj":[2,3,4,3,4,4,7,9,2]},{"id":19,"text":"إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ","tj":[2,5,1,7,8,3,24,28,1,30,31,3]},{"id":20,"text":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ","tj":[14,17,1,22,23,4,36,37,3]},{"id":21,"text":"مُّطَاعٍ ثَمَّ أَمِينٍ","tj":[7,11,1,11,14,1,19,20,3]},{"id":22,"text":"وَمَا صَاحِبُكُم بِمَجْنُونٍ","tj":[15,19,1,21,23,2,25,26,3]},{"id":23,"text":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ","tj":[6,8,2,19,20,4,29,30,4,36,37,3]},{"id":24,"text":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ","tj":[17,18,4,33,34,3]},{"id":25,"text":"وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍ رَّجِيمٍ","tj":[26,27,3,28,33,1,35,36,3]},{"id":26,"text":"فَأَيْنَ تَذْهَبُونَ","tj":[17,18,3]},{"id":27,"text":"إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَٰلَمِينَ","tj":[22,27,1,31,32,3,36,37,3]},{"id":28,"text":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ","tj":[4,8,1,8,10,3,15,18,1,23,27,1,33,34,3]},{"id":29,"text":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ","tj":[10,12,3,23,25,3,28,32,1,34,36,3,39,40,4,53,54,4,58,59,3,63,64,3]}]}