{"surah":106,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لِإِيلَٰفِ قُرَيْشٍ","tj":[46,47,3,54,55,3]},{"id":2,"text":"إِۦلَٰفِهِمْ رِحْلَةَ ٱلشِّتَآءِ وَٱلصَّيْفِ","tj":[2,3,3,5,6,3,22,23,4,23,24,4,29,31,3,36,37,4,37,38,4,41,42,3]},{"id":3,"text":"فَلْيَعْبُدُوا۟ رَبَّ هَٰذَا ٱلْبَيْتِ","tj":[13,15,4,24,25,3,29,30,4,34,35,3]},{"id":4,"text":"ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍ وَءَامَنَهُم مِّنْ خَوْفٍۭ","tj":[6,8,3,11,13,2,19,24,1,24,28,1,30,34,1,43,48,1,53,54,3]}]}