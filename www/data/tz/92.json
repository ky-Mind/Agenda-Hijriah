{"surah":92,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلَّيْلِ إِذَا يَغْشَىٰ","tj":[41,42,4]},{"id":2,"text":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ","tj":[2,3,4,3,4,4,4,7,1]},{"id":3,"text":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","tj":[13,14,4,14,15,4,25,26,4,30,33,1]},{"id":4,"text":"إِنَّ سَعْيَكُمْ لَشَتَّىٰ","tj":[2,5,1]},{"id":5,"text":"فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ","tj":[4,7,1,25,26,4]},{"id":6,"text":"وَصَدَّقَ بِٱلْحُسْنَىٰ","tj":[12,13,4]},{"id":7,"text":"فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ","tj":[15,16,3]},{"id":8,"text":"وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ","tj":[4,7,1,12,15,1,23,24,4]},{"id":9,"text":"وَكَذَّبَ بِٱلْحُسْنَىٰ","tj":[12,13,4]},{"id":10,"text":"فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ","tj":[15,16,3]},{"id":11,"text":"وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ","tj":[28,30,3]},{"id":12,"text":"إِنَّ عَلَيْنَا لَلْهُدَىٰ","tj":[2,5,1]},{"id":13,"text":"وَإِنَّ لَنَا لَلْـَٔاخِرَةَ وَٱلْأُولَىٰ","tj":[4,7,1,30,31,4]},{"id":14,"text":"فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ","tj":[4,7,1,20,25,1]},{"id":15,"text":"لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى","tj":[11,12,3,14,16,3,24,25,4]},{"id":16,"text":"ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ","tj":[]},{"id":17,"text":"وَسَيُجَنَّبُهَا ٱلْأَتْقَى","tj":[8,11,1,17,18,4]},{"id":18,"text":"ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ","tj":[23,24,3]},{"id":19,"text":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍ تُجْزَىٰٓ","tj":[17,20,1,22,23,3,26,31,1,36,40,1,40,42,2]},{"id":20,"text":"إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ","tj":[7,8,4,8,10,2,14,16,3,21,23,2,34,35,4]},{"id":21,"text":"وَلَسَوْفَ يَرْضَىٰ","tj":[]}]}