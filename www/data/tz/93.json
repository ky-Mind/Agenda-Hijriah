{"surah":93,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلضُّحَىٰ","tj":[41,42,4,42,43,4]},{"id":2,"text":"وَٱلَّيْلِ إِذَا سَجَىٰ","tj":[2,3,4]},{"id":3,"text":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","tj":[]},{"id":4,"text":"وَلَلْـَٔاخِرَةُ خَيْرٌ لَّكَ مِنَ ٱلْأُولَىٰ","tj":[21,26,1,34,35,4]},{"id":5,"text":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ","tj":[]},{"id":6,"text":"أَلَمْ يَجِدْكَ يَتِيمًا فَـَٔاوَىٰ","tj":[11,13,2,22,27,1]},{"id":7,"text":"وَوَجَدَكَ ضَآلًّا فَهَدَىٰ","tj":[13,15,3,17,22,1]},{"id":8,"text":"وَوَجَدَكَ عَآئِلًا فَأَغْنَىٰ","tj":[13,15,3,18,23,1]},{"id":9,"text":"فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ","tj":[4,7,1,9,10,4,28,30,2]},{"id":10,"text":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ","tj":[4,7,1,9,10,4,10,11,4,14,16,3]},{"id":11,"text":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ","tj":[4,7,1]}]}