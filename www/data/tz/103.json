{"surah":103,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْعَصْرِ","tj":[41,42,4]},{"id":2,"text":"إِنَّ ٱلْإِنسَٰنَ لَفِى خُسْرٍ","tj":[2,5,1,6,7,4,11,14,1,14,15,3]},{"id":3,"text":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ وَتَوَاصَوْا۟ بِٱلْحَقِّ وَتَوَاصَوْا۟ بِٱلصَّبْرِ","tj":[7,8,4,25,27,4,37,39,4,40,41,4,41,42,4,45,46,3,50,51,3,65,67,4,70,71,4,90,92,4,95,96,4,96,97,4,100,102,2]}]}