{"surah":94,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","tj":[62,64,2]},{"id":2,"text":"وَوَضَعْنَا عَنكَ وِزْرَكَ","tj":[14,17,1]},{"id":3,"text":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","tj":[6,8,3,11,14,1]},{"id":4,"text":"وَرَفَعْنَا لَكَ ذِكْرَكَ","tj":[]},{"id":5,"text":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","tj":[4,7,1,13,14,4]},{"id":6,"text":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","tj":[2,5,1,11,12,4]},{"id":7,"text":"فَإِذَا فَرَغْتَ فَٱنصَبْ","tj":[19,20,4,20,23,1,23,25,2]},{"id":8,"text":"وَإِلَىٰ رَبِّكَ فَٱرْغَب","tj":[19,20,4,24,25,2]}]}