{"surah":70,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَأَلَ سَآئِلٌۢ بِعَذَابٍ وَاقِعٍ","tj":[48,50,3,53,57,1,64,68,1]},{"id":2,"text":"لِّلْكَٰفِرِينَ لَيْسَ لَهُۥ دَافِعٌ","tj":[7,8,3,27,28,3]},{"id":3,"text":"مِّنَ ٱللَّهِ ذِى ٱلْمَعَارِجِ","tj":[6,7,4,18,19,4,28,29,2]},{"id":4,"text":"تَعْرُجُ ٱلْمَلَٰٓئِكَةُ وَٱلرُّوحُ إِلَيْهِ فِى يَوْمٍ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٍ","tj":[9,10,4,16,18,3,27,28,4,28,29,4,54,58,1,64,66,2,73,74,3]},{"id":5,"text":"فَٱصْبِرْ صَبْرًا جَمِيلًا","tj":[2,3,4,12,14,2,15,20,1]},{"id":6,"text":"إِنَّهُمْ يَرَوْنَهُۥ بَعِيدًا","tj":[2,5,1,20,21,3]},{"id":7,"text":"وَنَرَىٰهُ قَرِيبًا","tj":[7,8,3]},{"id":8,"text":"يَوْمَ تَكُونُ ٱلسَّمَآءُ كَٱلْمُهْلِ","tj":[15,16,4,16,17,4,22,24,3,29,30,4]},{"id":9,"text":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ","tj":[10,11,4,23,24,4]},{"id":10,"text":"وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيمًا","tj":[]},{"id":11,"text":"يُبَصَّرُونَهُمْ يَوَدُّ ٱلْمُجْرِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِذٍۭ بِبَنِيهِ","tj":[25,26,4,30,32,2,74,78,1,83,84,3]},{"id":12,"text":"وَصَٰحِبَتِهِۦ وَأَخِيهِ","tj":[4,5,3,13,14,3,21,22,3]},{"id":13,"text":"وَفَصِيلَتِهِ ٱلَّتِى تُـْٔوِيهِ","tj":[14,15,4,29,30,3]},{"id":14,"text":"وَمَن فِى ٱلْأَرْضِ جَمِيعًا ثُمَّ يُنجِيهِ","tj":[4,8,1,10,11,4,26,31,1,31,34,1,37,40,1,40,41,3]},{"id":15,"text":"كَلَّآ إِنَّهَا لَظَىٰ","tj":[5,7,3,10,13,1]},{"id":16,"text":"نَزَّاعَةً لِّلشَّوَىٰ","tj":[9,14,1,14,15,4]},{"id":17,"text":"تَدْعُوا۟ مَنْ أَدْبَرَ وَتَوَلَّىٰ","tj":[2,4,2,7,9,4,17,19,2]},{"id":18,"text":"وَجَمَعَ فَأَوْعَىٰٓ","tj":[]},{"id":19,"text":"إِنَّ ٱلْإِنسَٰنَ خُلِقَ هَلُوعًا","tj":[2,5,1,6,7,4,11,14,1,14,15,3]},{"id":20,"text":"إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعًا","tj":[14,15,4,15,16,4]},{"id":21,"text":"وَإِذَا مَسَّهُ ٱلْخَيْرُ مَنُوعًا","tj":[16,17,4]},{"id":22,"text":"إِلَّا ٱلْمُصَلِّينَ","tj":[7,8,4,17,18,3]},{"id":23,"text":"ٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَ","tj":[36,38,3,42,43,3]},{"id":24,"text":"وَٱلَّذِينَ فِىٓ أَمْوَٰلِهِمْ حَ