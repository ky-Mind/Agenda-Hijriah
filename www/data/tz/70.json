,10,15,1,28,34,1,65,66,3]},{"id":42,"text":"فَذَرْهُمْ يَخُوضُوا۟ وَيَلْعَبُوا۟ حَتَّىٰ يُلَٰقُوا۟ يَوْمَهُمُ ٱلَّذِى يُوعَدُونَ","tj":[19,21,4,33,35,4,48,49,3,52,54,4,66,67,4,81,82,3]},{"id":43,"text":"يَوْمَ يَخْرُجُونَ مِنَ ٱلْأَجْدَاثِ سِرَاعًا كَأَنَّهُمْ إِلَىٰ نُصُبٍ يُوفِضُونَ","tj":[24,25,4,29,31,2,43,48,1,50,53,1,70,74,1,79,80,3]},{"id":44,"text":"خَٰشِعَةً أَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌ ذَٰلِكَ ٱلْيَوْمُ ٱلَّذِى كَانُوا۟ يُوعَدُونَ","tj":[2,3,3,12,14,2,16,17,3,43,47,1,47,48,3,53,54,4,63,64,4,77,79,4,87,88,3]}]}