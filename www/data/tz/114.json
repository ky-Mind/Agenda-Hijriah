{"surah":114,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","tj":[60,61,4,61,62,4,62,65,1,65,66,3]},{"id":2,"text":"مَلِكِ ٱلنَّاسِ","tj":[7,8,4,8,9,4,9,12,1,12,13,3]},{"id":3,"text":"إِلَٰهِ ٱلنَّاسِ","tj":[4,5,3,8,9,4,9,10,4,10,13,1,13,14,3]},{"id":4,"text":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","tj":[2,6,1,10,11,4,23,24,4,28,31,1,31,32,3]},{"id":5,"text":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","tj":[31,32,4,32,33,4,33,36,1,36,37,3]},{"id":6,"text":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","tj":[5,6,4,10,13,1,18,19,4,19,20,4,20,23,1,23,24,3]}]}