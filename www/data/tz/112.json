{"surah":112,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ هُوَ ٱللَّهُ أَحَدٌ","tj":[49,50,4,61,62,2]},{"id":2,"text":"ٱللَّهُ ٱلصَّمَدُ","tj":[8,9,4,9,10,4,15,16,2]},{"id":3,"text":"لَمْ يَلِدْ وَلَمْ يُولَدْ","tj":[9,11,2,24,26,2]},{"id":4,"text":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","tj":[11,16,1,18,19,3,32,33,2]}]}