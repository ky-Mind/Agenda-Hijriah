{"surah":77,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْمُرْسَلَٰتِ عُرْفًا","tj":[41,42,4,52,53,3]},{"id":2,"text":"فَٱلْعَٰصِفَٰتِ عَصْفًا","tj":[2,3,4,7,8,3,12,13,3]},{"id":3,"text":"وَٱلنَّٰشِرَٰتِ نَشْرًا","tj":[2,3,4,3,4,4,4,7,1,7,8,3,12,13,3]},{"id":4,"text":"فَٱلْفَٰرِقَٰتِ فَرْقًا","tj":[2,3,4,7,8,3,12,13,3]},{"id":5,"text":"فَٱلْمُلْقِيَٰتِ ذِكْرًا","tj":[2,3,4,13,14,3]},{"id":6,"text":"عُذْرًا أَوْ نُذْرًا","tj":[]},{"id":7,"text":"إِنَّمَا تُوعَدُونَ لَوَٰقِعٌ","tj":[2,5,1,24,25,3]},{"id":8,"text":"فَإِذَا ٱلنُّجُومُ طُمِسَتْ","tj":[8,9,4,9,10,4,10,13,1]},{"id":9,"text":"وَإِذَا ٱلسَّمَآءُ فُرِجَتْ","tj":[8,9,4,9,10,4,15,17,3]},{"id":10,"text":"وَإِذَا ٱلْجِبَالُ نُسِفَتْ","tj":[8,9,4]},{"id":11,"text":"وَإِذَا ٱلرُّسُلُ أُقِّتَتْ","tj":[8,9,4,9,10,4]},{"id":12,"text":"لِأَىِّ يَوْمٍ أُجِّلَتْ","tj":[]},{"id":13,"text":"لِيَوْمِ ٱلْفَصْلِ","tj":[9,10,4]},{"id":14,"text":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ","tj":[4,6,3,9,11,2,14,15,3,29,30,4]},{"id":15,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","tj":[5,9,1,16,21,1,32,33,3]},{"id":16,"text":"أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ","tj":[16,17,4,26,27,3]},{"id":17,"text":"ثُمَّ نُتْبِعُهُمُ ٱلْـَٔاخِرِينَ","tj":[2,5,1,19,20,4,29,30,3]},{"id":18,"text":"كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ","tj":[4,5,3,21,22,4,26,28,2,32,33,3]},{"id":19,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","tj":[5,9,1,16,21,1,32,33,3]},{"id":20,"text":"أَلَمْ نَخْلُقكُّم مِّن مَّآءٍ مَّهِينٍ","tj":[13,14,1,17,22,1,22,27,1,27,29,3,30,35,1,37,38,3]},{"id":21,"text":"فَجَعَلْنَٰهُ فِى قَرَارٍ مَّكِينٍ","tj":[10,11,3,24,29,1,31,32,3]},{"id":22,"text":"إِلَىٰ قَدَرٍ مَّعْلُومٍ","tj":[12,17,1,21,22,3]},{"id":23,"text":"فَقَدَرْنَا فَنِعْمَ ٱلْقَٰدِرُونَ","tj":[21,22,4,26,27,3,31,32,3]},{"id":24,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","tj":[5,9,1,16,21,1,32,33,3]},{"id":25,"text":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا","tj":[9,11,2,16,17,4]},{"id":26,"text":"أَحْيَآءً وَأَمْوَٰتًا","tj":[6,8,3,9,13,1,19,20,3]},{"id":27,"text":"وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَٰمِخَٰتٍ وَأَسْقَيْنَٰكُم مَّآءً فُرَاتًا","tj":[23,24,3,31,32,3,36,37,3,38,42,1,52,53,3,55,60,1,60,62,3,63,67,1]},{"id":28,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","tj":[5,9,1,16,21,1,32,33,3]},{"id":29,"text":"ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ","tj":[1,4,1,8,10,3,10,12,4,26,29,1,29,33,1,35,36,3,46,47,3]},{"id":30,"text":"ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّ ذِى ثَلَٰثِ شُعَبٍ","tj":[1,4,1,8,10,3,10,12,4,24,28,1,34,35,3,42,43,2]},{"id":31,"text":"لَّا ظَلِيلٍ وَلَا يُغْنِى مِنَ ٱللَّهَبِ","tj":[11,15,1,32,33,4,33,34,4,39,40,2]},{"id":32,"text":"إِنَّهَا تَرْمِى بِشَرَرٍ كَٱلْقَصْرِ","tj":[2,5,1,24,28,1,28,29,4]},{"id":33,"text":"كَأَنَّهُۥ جِمَٰلَتٌ صُفْرٌ","tj":[4,7,1,9,10,3,15,16,3,19,23,1]},{"id":34,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","tj":[5,9,1,16,21,1,32,33,3]},{"id":35,"text":"هَٰذَا يَوْمُ لَا يَنطِقُونَ","tj":[2,3,3,20,23,1,25,26,3]},{"id":36,"text":"وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ","tj":[34,35,3]},{"id":37,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","tj":[5,9,1,16,21,1,32,33,3]},{"id":38,"text":"هَٰذَا يَوْمُ ٱلْفَصْلِ جَمَعْنَٰكُمْ وَٱلْأَوَّلِينَ","tj":[2,3,3,14,15,4,32,33,3,40,41,4,50,51,3]},{"id":39,"text":"فَإِن كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ","tj":[4,8,1,24,28,1,33,34,3]},{"id":40,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","tj":[5,9,1,16,21,1,32,33,3]},{"id":41,"text":"إِنَّ ٱلْمُتَّقِينَ فِى ظِلَٰلٍ وَعُيُونٍ","tj":[2,5,1,6,7,4,28,29,3,30,34,1,38,39,3]},{"id":42,"text":"وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ","tj":[6,7,3,14,17,1,27,28,3]},{"id":43,"text":"كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ","tj":[5,7,4,10,11,4,18,20,4,25,27,3,29,34,1,41,44,1,55,56,3]},{"id":44,"text":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ","tj":[2,5,1,11,12,3,19,21,2,25,26,4,36,37,3]},{"id":45,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","tj":[5,9,1,16,21,1,32,33,3]},{"id":46,"text":"كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ","tj":[5,7,4,20,22,4,34,37,1,39,44,1,44,46,2,50,51,3]},{