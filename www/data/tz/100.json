{"surah":100,"verses":[{"id":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْعَٰدِيَٰتِ ضَبْحًا","tj":[41,42,4,46,47,3,51,52,3,57,59,2]},{"id":2,"text":"فَٱلْمُورِيَٰتِ قَدْحًا","tj":[2,3,4,12,13,3,18,20,2]},{"id":3,"text":"فَٱلْمُغِيرَٰتِ صُبْحًا","tj":[2,3,4,12,13,3,18,20,2]},{"id":4,"text":"فَأَثَرْنَ بِهِۦ نَقْعًا","tj":[15,16,3,19,21,2]},{"id":5,"text":"فَوَسَطْنَ بِهِۦ جَمْعًا","tj":[6,8,2,15,16,3]},{"id":6,"text":"إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌ","tj":[2,5,1,6,7,4,11,14,1,14,15,3,27,28,3,35,36,3,36,37,2]},{"id":7,"text":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ","tj":[4,7,1,9,10,3,20,21,3,32,33,3,33,34,2]},{"id":8,"text":"وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ","tj":[4,7,1,9,10,3,19,20,4,35,36,3,36,37,2]},{"id":9,"text":"أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ","tj":[40,41,4,47,48,3]},{"id":10,"text":"وَحُصِّلَ مَا فِى ٱلصُّدُورِ","tj":[18,19,4,19,20,4,25,26,3]},{"id":11,"text":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍ لَّخَبِيرٌۢ","tj":[2,5,1,13,17,1,31,36,1,40,41,3]}]}