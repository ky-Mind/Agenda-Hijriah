{"surah":95,"verses":[{"id":1,"text":"بِّسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلتِّينِ وَٱلزَّيْتُونِ","tj":[42,43,4,43,44,4,53,54,4,54,55,4,62,63,3]},{"id":2,"text":"وَطُورِ سِينِينَ","tj":[13,14,3]},{"id":3,"text":"وَهَٰذَا ٱلْبَلَدِ ٱلْأَمِينِ","tj":[4,5,3,9,10,4,19,20,4,26,27,3]},{"id":4,"text":"لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍ","tj":[4,6,2,11,13,2,17,18,4,22,25,1,25,26,3,31,33,3,45,47,2,49,50,3]},{"id":5,"text":"ثُمَّ رَدَدْنَٰهُ أَسْفَلَ سَٰفِلِينَ","tj":[2,5,1,10,12,2,14,15,3,29,30,3,34,35,3]},{"id":6,"text":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ","tj":[7,8,4,25,27,4,37,39,4,40,41,4,41,42,4,45,46,3,50,51,3,65,67,2,83,84,3]},{"id":7,"text":"فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ","tj":[27,28,4,28,29,4,32,33,3]},{"id":8,"text":"أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَٰكِمِينَ","tj":[9,10,4,28,29,4,33,34,3,38,39,3]}]}